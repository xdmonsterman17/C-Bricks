@tool
extends RefCounted

## Turns a BrickscriptFlowGraph (wire graph) into GDScript source. Pure data
## in, text out: no editor or scene dependencies, so it runs headless.
##
##   var compiler: RefCounted = preload("flow_compiler.gd").new()
##   var source: String = compiler.compile(graph)
##   if not compiler.errors.is_empty(): ...
##
## How a graph runs:
## - Each event node becomes (part of) a Godot callback. Its numbered exits
##   fire in order, each chain to its end, before the next one starts.
## - Exec wires set the order. A node reached by several wires is written
##   out once per path (wires can't loop: loops will be loop nodes).
## - Values pass through variables. A node's Output Var makes a chain variable
##   (declared at the top of its event's run, starting at its type's default),
##   or with Use Var writes into an existing chain or script variable. Set Var
##   with a new name makes a Shared (default) or Chain variable; Constant and
##   Export Set Vars (and Shared ones no event reaches) declare script
##   variables with their typed-in value.
## - Inputs read a variable by name, or a typed-in value (via var_to_str(), so
##   typed text never becomes code). Formulas are checked name by name.
##
## Map of this file (by function; regions in this order):
## - compile() / _run(): the whole pass: checks every brick may be used here
##   (contexts), declares script variables, compiles each event, then the
##   _ready setup lines (Sync, Synced variables, players / input
##   events' connections, server parts without the engine, the from-file
##   check), and assembles the script (server guard, helpers).
## - Script variables: Constant / Export / Shared declarations
##   (_declare_from_set_vars, _declaration), name checks.
## - Events and exec wires: _compile_event (guards, Runs on, waiting events
##   in their own function), _emit_from (walks the wires: If, loops,
##   Raycast's Hit / Nothing hit branch like an If).
## - Nodes (most bricks): _node_lines routes each brick: Set Var
##   (_set_var), the node bricks (below), Formula (_formula), then template
##   bricks (`code` / `result` in flow_library.gd, with settings and inputs
##   filled in); values and variables: _input, _read, _assign / _output,
##   _can_change; If (_if_condition), loops (_loop_start), lists (_make_list).
## - Node bricks: _node_brick (Get node, Find node, As script, Get children,
##   Nodes in group, Character, Host / Join, Get / Set property (Set / Add),
##   Call method, Wait for signal), _physics_query (Bodies near, Raycast),
##   _spawn_scene, _emit_signal, _call_method; event kinds with their own
##   function: _signal_event (When signal received), _players_event (When a
##   player joins / leaves, player data), _input_event (players' input);
##   _sync_declaration (Sync); _local_guard (what a local
##   brickscript may change); members of node types (_find_member,
##   _member_read / _member_write, _value_fits).
## - Last: trace lines, the `# brick <id>` marker, template filling, _where
##   (the "Brick (node 4)" prefix of every error).

const Library = preload("flow_library.gd")
const Types = preload("flow_types.gd")
const Ops = preload("flow_ops.gd")
const NodeTypes = preload("node_types.gd")
## Cyclic on purpose (brick_file.gd compiles graphs): to read another
## brickscript's variables.
const BrickFile = preload("brick_file.gd")
const T = Types.ValueType
const Kind = BrickscriptVariable.Kind
## A script node's icon in the Scene dock (local / server).
const LOCAL_ICON: String = "res://addons/brickscript/icons/brickscript.svg"
const SERVER_ICON: String = "res://addons/brickscript/icons/brickscript_server.svg"
## First line of every generated script: marks scripts Brickscript may
## overwrite (it never overwrites any other).
const HEADER: String = "# Generated by Brickscript. Do not edit: this file is rewritten from its graph."
## Server brickscripts (graph.context == &"server"): every event first checks
## that this machine has server authority. The Network Context Engine is
## reached by name only (the plugins never reference each other); without it,
## the game is single-player and its own server, so everything runs.
const SERVER_NOTE: String = "# Server brickscript: its events run only where the game has server authority."
const SERVER_GUARD: String = "\tif not _brickscript_has_server_authority():\n\t\treturn"
## A function holding a predicted event: also on the machine predicting it.
const PREDICTED_GUARD: String = "\tif not (_brickscript_has_server_authority() or _brickscript_predicting()):\n\t\treturn"
const SERVER_HELPER: String = """func _brickscript_has_server_authority() -> bool:
	var engine: Node = get_node_or_null(^"/root/NetworkEngine")
	return engine == null or bool(engine.call(&"has_server_authority"))"""
## Projects with the Network Context Engine (detected by its autoload only).
const NETWORK_AUTOLOAD_SETTING: String = "autoload/NetworkEngine"
## Names a variable may not take: GDScript keywords, built-in types, common
## global functions, and the names of event values.
const RESERVED_NAMES: PackedStringArray = [
	"if", "elif", "else", "for", "while", "match", "when", "break", "continue", "pass",
	"return", "class", "class_name", "extends", "is", "in", "as", "self", "super", "signal",
	"func", "static", "const", "enum", "var", "breakpoint", "preload", "await", "yield",
	"assert", "void", "and", "or", "not", "true", "false", "null", "PI", "TAU", "INF", "NAN",
	"bool", "int", "float", "String", "StringName", "NodePath", "Array", "Dictionary",
	"Callable", "Signal", "Variant", "Color", "Rect2", "Rect2i", "Vector2", "Vector2i",
	"Vector3", "Vector3i", "Vector4", "Vector4i", "Transform2D", "Transform3D", "Basis",
	"Quaternion", "Plane", "Projection", "AABB", "RID",
	"print", "prints", "printt", "print_rich", "push_error", "push_warning", "str", "range",
	"len", "load", "typeof", "abs", "min", "max", "clamp", "lerp", "sin", "cos", "tan",
	"sqrt", "pow", "floor", "ceil", "round", "randf", "randi", "randf_range", "randi_range",
	"delta", "event", "message", "values", "sender", "_brickscript_has_server_authority",
	"_brickscript_tell_server", "_brickscript_client_told", "_brickscript_tell_clients",
	"_brickscript_server_told", "_brickscript_on_client_told", "_brickscript_hand_to_server_part",
	"_brickscript_listen", "_brickscript_typed", "_brickscript_local_only", "_brickscript_local_spawn", "_brickscript_server_part_alone", "_holder", "_brickscript_from_file",
	"_brickscript_player_strength", "_brickscript_player_direction", "_brickscript_players_holding", "_brickscript_on_player_actions", "_brickscript_poll_actions", "_brickscript_action_events", "_brickscript_actions_held",
]

## Stops runaway graphs: a chain of Ifs that all merge again doubles the code
## per If, since merged paths are written out once per path.
const MAX_LINES: int = 20000
## Names a formula may use besides variables.
const FORMULA_NAMES: PackedStringArray = [
	"and", "or", "not", "true", "false", "PI", "TAU", "INF",
	"abs", "sign", "min", "max", "clamp", "clampf", "clampi", "lerp", "lerpf", "inverse_lerp",
	"sqrt", "pow", "exp", "log", "floor", "ceil", "round", "floori", "ceili", "roundi",
	"sin", "cos", "tan", "asin", "acos", "atan", "atan2", "deg_to_rad", "rad_to_deg",
	"snapped", "fmod", "fposmod", "posmod", "wrapf", "wrapi", "move_toward", "is_zero_approx",
	"is_equal_approx", "randf", "randi", "randf_range", "randi_range", "str", "int", "float",
	"bool", "len", "Vector2", "Vector3", "Color",
	# What a value is (e.g. a network message's values: typeof(x) == TYPE_VECTOR3).
	"typeof", "TYPE_NIL", "TYPE_BOOL", "TYPE_INT", "TYPE_FLOAT", "TYPE_STRING", "TYPE_VECTOR2", "TYPE_VECTOR3",
	"TYPE_COLOR", "TYPE_OBJECT", "TYPE_ARRAY", "TYPE_DICTIONARY",
]

## Problems found by the last compile(), each prefixed with where it is
## (e.g. "Subtract (node 4) > a: ..."). Any error means no source.
var errors: PackedStringArray = []
## Non-fatal findings (unknown Input Map actions, results not kept, nodes not
## connected to an event). The source is still produced.
var warnings: PackedStringArray = []
## What each reached node can see, by node id: variable name -> {"type",
## "writable", "origin" ("chain", "event", "Constant", "Export", "Shared")}.
## Recorded just before the node itself runs, so it holds the chain
## variables of nodes that run earlier in the same event (for the editor's
## variable dropdowns).
var scopes: Dictionary[int, Dictionary] = {}
## Shared variables made by Set Var ("Keep between runs" on a new name) in
## the last compile: name -> ValueType (for the Variables panel).
var made_shared: Dictionary[String, int] = {}
## false: other brickscripts' variables aren't looked up (used while working
## them out for another compile, so two brickscripts reading each other
## don't load each other forever).
var foreign: bool = true
## The graph's file, if it has one: a server brickscript's "this node" is the
## node running its paired local script (<name>.bricklocal / .local.gd).
var source_path: String = ""
## true: each brick reports itself as it runs (`_brickscript_trace(<id>)`),
## for the editor to light it up (Trace on the Brickscript toolbar; only in
## games run from the editor, see brick_file.gd trace_enabled()).
var trace: bool = false

var _base_type: StringName = &""
var _nodes: Dictionary[int, BrickscriptFlowNode] = {}
## Script variables by name: {"type", "writable", "kind"}.
var _script: Dictionary[String, Dictionary] = {}
## Shared variables made by wired Set Vars (a new name, kind Shared), name ->
## type. Kept between the two passes of compile().
var _implicit: Dictionary[String, int] = {}
## Node types of Shared variables made by Set Var holding a Node.
var _implicit_nodes: Dictionary[String, Dictionary] = {}
## "This node": the base type, and this brickscript's own variables.
var _self_type: Dictionary = {}
## What the path ".." is (the graph's parent_type).
var _parent_type: Dictionary = {}
## Self in a script node: the script node itself (its own variables).
var _own_type: Dictionary = {}
## Node ids some event's chain reaches.
var _reached: Dictionary[int, bool] = {}
## Set Var node ids that declare a script variable (see _declare_from_set_vars).
var _declaring: Dictionary[int, bool] = {}
var _line_count: int = 0

## The event being compiled: its chain variables (name -> {"type", "gd"}, in
## the order they were made), the values its event provides, its function.
var _chain: Dictionary[String, Dictionary] = {}
var _provided: Dictionary = {}
var _function: Dictionary = {}
var _event_number: int = 0
## How many loop bodies the brick being compiled is inside (Break / Continue
## need at least one).
var _loop_depth: int = 0
## Helper code of the bricks reached (Library `helper`), in order of first use.
var _helpers: PackedStringArray = []
## Function name -> {"params" ([name, GDScript type, vararg?]), "lines",
## "used" (params read), "names" (local names taken), "annotation",
## "prelude"}, in order of first use.
var _functions: Dictionary[String, Dictionary] = {}
## Lines run first in _ready (connecting When signal received).
var _setup: PackedStringArray = []
## Setup lines of predicted events (they run on the predicting machine too).
var _predicted_setup: PackedStringArray = []
## Whether this server brickscript has predicted events (Runs on: the server
## and its player's machine), and the functions that hold them.
var _any_predicted: bool = false
var _predicted_functions: Dictionary[String, bool] = {}
## Whether the event being compiled is predicted.
var _event_predicted: bool = false
## Signals this brickscript emits: name -> {"types", "nodes"} (per value).
var _signals: Dictionary[String, Dictionary] = {}
## The signals of the previous pass of compile(): a When signal received of
## this brickscript's own signal may come before its Emit signal.
var _prior_signals: Dictionary[String, Dictionary] = {}
## Node types of the values the current event provides (signal values).
var _provided_nodes: Dictionary = {}
## Whether the event being compiled runs a brick that waits.
var _event_waits: bool = false
## The event's chain has a local change that may be refused when the game
## runs (_guarded()): it stops there, so the chain gets a function of its own.
var _event_stops: bool = false
## A Define Function's GDScript function is this + its name.
const FUNCTION_PREFIX: String = "_bf_"
## The functions this brickscript defines, learned on each pass of compile()
## (a chain may call one defined further on): name -> {"returns" (a type, -1:
## nothing), "returns_node", "waits"}.
var _function_info: Dictionary[String, Dictionary] = {}
## Whether this pass learned nothing new about the functions.
var _settled: bool = true
## This pass: function name -> its Define Function node (Ops.functions_of),
## and the names already compiled (a second one with a name is an error).
var _function_nodes: Dictionary = {}
var _defined: Dictionary[String, int] = {}
## What the Returns of the function being compiled give: [type (-1:
## nothing), node type, where].
var _returns: Array = []
## The type of the event being compiled (Answer needs On Client Invoked).
var _event_type: StringName = &""
## Code for "this node": `self`, or in a server brickscript the node it
## belongs to (its parent, `_brickscript_body`).
var _self_code: String = "self"
var _server: bool = false
## Acts for another node, its body (a server part, or a script node: the
## parent): `_brickscript_body`; a script node's paths start at itself (Self),
## its parent is Self.Parent (see _script_node_path).
var _body: bool = false
var _script_node: bool = false
## A shared brickscript (graph.shared).
var _shared: bool = false
## Shared brickscripts called From: A file, by path: {"functions" (name ->
## Define Function node), "info" (its _function_info), "server", "problem"}.
## Static: a file calling another compiles it once; `compiling` catches two
## calling each other.
static var _shared_files: Dictionary = {}
const SELF_PATH: String = "res://addons/brickscript/core/flow_compiler.gd"
## A player's node (what a Player value is).
const PLAYER_SCRIPT: String = "res://addons/brickscript/runtime/player.gd"
static var _compiling: Dictionary = {}
## A server brickscript listening to a signal a local script declares: on the
## host that would run for the host's player only, never for clients.
const LOCAL_SIGNAL_REFUSED: String = "%s > signal: '%s' is %s's own signal: a local script's, so a server brickscript can't react to it (on the host it would run for the host's player only). Send it with Fire Server, and react with On Client Fired."
## Events that run every frame: a Wait in them starts a new wait each frame.
const EVERY_FRAME_EVENTS: Array[StringName] = [&"event_process", &"event_physics_process", &"event_action_held", &"event_player_holds"]
## _local_guard(): the change isn't allowed (an error is recorded).
const LOCAL_REFUSED: String = "!"
## A local brickscript only reads its Synced variables: the server sets them.
const SYNCED_BY_SERVER: String = "%s: '%s' is Synced, so only the server changes it (Property (Set) on this node, from the server brickscript); here it can only be read"
## Synced variables (Set Var kind Synced): name -> true.
var _synced: Dictionary[String, bool] = {}
## Exports shown on another node's Inspector: name -> its path from the node
## the brickscript acts for ("." itself). Compiled into SHOWN_ON_CONST.
var _shown_on: Dictionary[String, String] = {}
var _placeholder: RegEx = RegEx.create_from_string("\\{(\\w+)\\}")
var _identifier: RegEx = RegEx.create_from_string("^[A-Za-z_][A-Za-z0-9_]*")
var _number: RegEx = RegEx.create_from_string("^[0-9][A-Za-z0-9_.]*")


## Returns the generated source, or "" if anything is wrong (see `errors`).
func compile(graph: BrickscriptFlowGraph) -> String:
	_implicit.clear()
	_implicit_nodes.clear()
	_signals.clear()
	# The first pass learns the types of shared variables Set Var makes, so a
	# chain compiled before the one that makes a variable can still read it.
	_function_info.clear()
	# (A brickscript calling back into this one gets its functions untyped.)
	var marked: bool = not source_path.is_empty() and not _compiling.has(source_path)
	if marked:
		_compiling[source_path] = true
	_run(graph)
	var source: String = _run(graph)
	# What functions give back and whether they wait is learned pass by
	# pass (one calling another): again while that's still changing.
	for _pass: int in 3:
		if _settled:
			break
		source = _run(graph)
	if marked:
		_compiling.erase(source_path)
	return source


func _run(graph: BrickscriptFlowGraph) -> String:
	errors.clear()
	warnings.clear()
	_script.clear()
	_nodes.clear()
	_reached.clear()
	_helpers.clear()
	_functions.clear()
	_setup.clear()
	_predicted_setup.clear()
	_predicted_functions.clear()
	_settled = true
	_defined.clear()
	_function_nodes = Ops.functions_of(graph) if graph != null else {}
	_any_predicted = graph.context == &"server" and graph.nodes.any(func(node: BrickscriptFlowNode) -> bool:
		return node != null and str(node.settings.get(&"runs_on", "")) == Library.PREDICTED)
	_prior_signals = _signals.duplicate()
	_signals.clear()
	scopes.clear()
	_line_count = 0
	if graph == null:
		errors.append("no graph")
		return ""
	_shared = graph.shared
	_script_node = graph.script_node and not _shared
	# A script node is a plain Node of its own (Self); it works for its parent.
	# A shared brickscript is a plain Node too, acting for no other node.
	_base_type = &"Node" if _script_node or _shared else graph.base_type
	_server = graph.context == &"server"
	_body = (_server or _script_node) and not _shared
	_self_type = {"class": _base_type, "self": true}
	_own_type = _self_type.duplicate()
	_parent_type = graph.parent_type
	_self_code = "self"
	_synced.clear()
	if _script_node:
		# Acts for its parent (its type found in the scenes by the editor; a
		# graph built in code may only say parent_type: the same node).
		var body: Dictionary = graph.body_type if not graph.body_type.is_empty() else graph.parent_type
		_self_type = body.duplicate() if not body.is_empty() else {"class": &"Node"}
		_self_code = "_brickscript_body"
	elif _server and not _shared:
		# A server brickscript acts for the node it's the server part of.
		_self_type = BrickFile.body_type_for(source_path, graph.body_type)
		_self_code = "_brickscript_body"
	# The node it acts for (a local script may change it when this machine's
	# player owns it: checked when the game runs).
	_self_type["acts_for"] = true
	if not ClassDB.class_exists(_base_type) or not ClassDB.is_parent_class(_base_type, &"Node"):
		errors.append("base type '%s' is not a Node class" % _base_type)
	var groups: Array[PackedStringArray] = _script_declarations(graph)
	for node: BrickscriptFlowNode in graph.nodes:
		if node == null:
			continue
		if _nodes.has(node.id):
			errors.append("node %d: id used twice" % node.id)
		elif Library.get_definition(node.type).is_empty():
			errors.append("node %d: unknown node type '%s'" % [node.id, node.type])
		else:
			_nodes[node.id] = node
			var contexts: Array = Library.get_definition(node.type).get("contexts", BrickscriptFlowGraph.CONTEXTS)
			if not contexts.has(graph.context):
				errors.append("%s: only works in a %s brickscript%s" % [_where(node, Library.get_definition(node.type)), contexts[0],
					" (a ServerScript: Scene dock, right-click the node > Add ServerScript (Brickscript)...)" if contexts[0] == &"server" else " (a LocalScript: Scene dock, right-click the node > Add LocalScript (Brickscript)...)" if contexts[0] == &"local" else ""])
			elif _shared and Library.get_definition(node.type)["kind"] == Library.Kind.EVENT and node.type != &"define_function":
				errors.append("%s: a shared brickscript holds only functions (Define Function) and its variables, no other events" % _where(node, Library.get_definition(node.type)))
			elif _shared and not _server and not contexts.has(&"server"):
				errors.append("%s: a shared brickscript Used by Both only takes bricks that work on either side, and this one is local only (or set Used by: Server only)" % _where(node, Library.get_definition(node.type)))
	_shown_on.clear()
	_declare_from_set_vars(graph, groups)
	var declarations: PackedStringArray = groups[0] + groups[1] + groups[2]
	if not _shown_on.is_empty():
		# Read by the editor's Inspector (editor/node_inspector.gd); plain, so
		# it's a constant expression.
		var plain: Dictionary = {}
		plain.merge(_shown_on)
		declarations.insert(0, "const %s: Dictionary = %s" % [SHOWN_ON_CONST, var_to_str(plain).replace("\n", " ")])

	_event_number = 0
	_loop_depth = 0
	for node: BrickscriptFlowNode in graph.nodes:
		if node == null or not _nodes.has(node.id) or _nodes[node.id] != node:
			continue
		var definition: Dictionary = Library.get_definition(node.type)
		if definition["kind"] != Library.Kind.EVENT:
			continue
		_event_number += 1
		if node.type == &"define_function":
			definition = _function_definition(node)
			if definition.is_empty():
				continue
		elif node.type == &"event_signal":
			definition = _signal_event(node, definition)
			if definition.is_empty():
				continue
		elif definition.has("players_signal"):
			definition = _players_event(node, definition)
		elif definition.has("player_values"):
			definition = _player_values_event(node, definition)
		elif definition.has("player_renamed"):
			definition = _player_renamed_event(node, definition)
		elif definition.has("spawner_signal"):
			definition = _spawner_event(node, definition)
		elif definition.has("died_signal"):
			definition = _died_event(node, definition)
		elif definition.has("culled_signal"):
			definition = _culled_event(node, definition)
		elif definition.has("terrain_signal"):
			definition = _terrain_event(node, definition)
		_event_predicted = _any_predicted and str(node.settings.get(&"runs_on", "")) == Library.PREDICTED
		if _event_predicted:
			_check_predicted_chain(node, definition)
		if definition.has("input_signal") or definition.has("each_holder"):
			definition = _input_event(node, definition)
		if _any_predicted and not _event_predicted and node.type != &"define_function":
			# In a brickscript with predicted events its functions also run on
			# the player's machine: the other events stay the server's.
			definition = definition.duplicate()
			definition["guard"] = "_brickscript_has_server_authority()" if str(definition.get("guard", "")).is_empty() else "(%s) and _brickscript_has_server_authority()" % definition["guard"]
		_function = _functions.get_or_add(definition["function"], {
			"params": definition["function_params"], "lines": [], "used": {}, "names": {},
			"annotation": definition.get("annotation", ""), "prelude": definition.get("prelude", ""),
			"players": _player_params(definition),
		})
		for param: Array in definition["function_params"]:
			# (What its prelude reads is used, whatever the bricks do.)
			if RegEx.create_from_string("\\b%s\\b" % param[0]).search(str(definition.get("prelude", ""))) != null:
				_function["used"][param[0]] = true
		if _event_predicted:
			_predicted_functions[definition["function"]] = true
		for helper: String in definition.get("event_helpers", []):
			_use_helper(helper)
		_returns.clear()
		_compile_event(node, definition)
		if node.type == &"define_function":
			_finish_function(node)
	for node: BrickscriptFlowNode in graph.nodes:
		if node != null and _nodes.get(node.id) == node and node.type == &"sync_property":
			_sync_declaration(node)
	if not _server and not _script_node and not _shared and not source_path.is_empty():
		# (A script node's server half is a ServerScript node of its own.)
		_use_helper(Library.SERVER_PART_ALONE_HELPER)
		_setup.append("\t_brickscript_server_part_alone.call_deferred()")
	for name: String in _synced:
		_use_helper(Library.SYNC_HELPER)
		_setup.append("\t_brickscript_sync(self, %s, true)" % var_to_str(name))
	var first: PackedStringArray = []
	if not source_path.is_empty():
		# First of all: a copy built into a scene does nothing.
		_use_helper(Library.FROM_FILE_HELPER)
		first.append("\tif not _brickscript_from_file(%s):\n\t\treturn" % var_to_str(source_path))
	var body_class: String = NodeTypes.gd_class(_self_type)
	if _body and body_class != "Node" and _uses_body():
		# Made for a parent of another type (the scene changed since): say so
		# once, as well as the bricks that then fail on a null "this node".
		first.append("\tif _brickscript_body == null and get_parent() != null:\n\t\tpush_error(\"%s: made for %s parent, but %%s is a %%s. Open it in the Brickscript tab (it reads the scenes again) and save it.\" %% [get_parent().name, get_parent().get_class()])" % [source_path.get_file() if not source_path.is_empty() else "This brickscript", ("an " if "AEIOU".contains(String(body_class).left(1)) else "a ") + String(body_class)])
	if _any_predicted:
		# _ready runs on the predicting machine too: there only the predicted
		# events' setup; all else (marking it predicted, other events' setup,
		# Sync, When ready) is the server's.
		_use_helper(Library.PREDICTION_HELPER)
		var ready: Dictionary = _functions.get_or_add("_ready", {"params": [], "lines": [], "used": {}, "names": {}, "annotation": "", "prelude": ""})
		var servers: Array = ["\t_brickscript_set_predicted()"] + Array(_setup) + ready["lines"]
		ready["lines"] = Array(first) + Array(_predicted_setup) + ["\tif _brickscript_has_server_authority():"] + servers.map(func(line: String) -> String: return "\t" + line.replace("\n", "\n\t"))
		_predicted_functions["_ready"] = true
	elif not _setup.is_empty() or not first.is_empty():
		var ready: Dictionary = _functions.get_or_add("_ready", {"params": [], "lines": [], "used": {}, "names": {}, "annotation": "", "prelude": ""})
		ready["lines"] = Array(first) + Array(_setup) + ready["lines"]

	var unreached: PackedStringArray = []
	for id: int in _nodes:
		if Library.get_definition(_nodes[id].type)["kind"] == Library.Kind.ACTION and not _reached.has(id) and not _declaring.has(id):
			unreached.append(_where(_nodes[id], Library.get_definition(_nodes[id].type)))
	if not unreached.is_empty():
		var named: String = ", ".join(unreached.slice(0, 5)) + (", ..." if unreached.size() > 5 else "")
		warnings.append("%d node(s) not connected to an event: they won't run (%s)" % [unreached.size(), named])
	for name: String in _implicit:
		if not _script.has(name):
			declarations.append("var %s: %s = %s" % [name, _gd_type(_implicit[name], _implicit_nodes.get(name, {})), _default_code(_implicit[name])])
	for name: String in _signals:
		var values: PackedStringArray = []
		for i: int in _signals[name]["types"].size():
			values.append("value_%d: %s" % [i + 1, _gd_type(_signals[name]["types"][i], _signals[name]["nodes"][i])])
		declarations.append("signal %s(%s)" % [name, ", ".join(values)])
	made_shared = _implicit.duplicate()
	if not errors.is_empty():
		return ""

	var server: bool = graph.context == &"server"
	if _body:
		declarations.append("@onready var _brickscript_body: %s = get_parent()%s" % [NodeTypes.gd_class(_self_type), "" if NodeTypes.gd_class(_self_type) == "Node" else " as " + NodeTypes.gd_class(_self_type)])
	var source: String = "%s\n%sextends %s\n" % [HEADER, "@icon(%s)\n" % var_to_str(SERVER_ICON if server else LOCAL_ICON) if _script_node else "", _base_type]
	if server:
		source += "\n" + SERVER_NOTE + "\n"
	if not declarations.is_empty():
		source += "\n" + "\n".join(declarations) + "\n"
	for function_name: String in _functions:
		var function: Dictionary = _functions[function_name]
		var params: PackedStringArray = []
		var players: PackedStringArray = []
		for param: Array in function["params"]:
			var param_name: String = param[0]
			if function.get("players", []).has(param_name) and function["used"].has(param_name):
				# The engine gives the player's number: the event's value is
				# their node.
				players.append("\tvar %s: BrickscriptPlayer = _brickscript_player(_peer_%s)" % [param_name, param_name])
				param_name = "_peer_" + param_name
				_use_helper(Library.PLAYER_NODE_HELPER)
			# Unused parameters get a leading underscore, as GDScript expects.
			params.append("%s%s%s: %s" % ["..." if param.size() > 2 and param[2] else "", "" if function["used"].has(param[0]) else "_", param_name, param[1]])
		var body: String = "\n".join(function["lines"])
		if not players.is_empty():
			body = "\n".join(players) + "\n" + body
		if not function["prelude"].is_empty():
			body = function["prelude"] + "\n" + body
		if server and not function.get("plain", false):
			# (A function runs when a chain calls it: that chain is guarded.)
			body = (PREDICTED_GUARD if _predicted_functions.has(function_name) else SERVER_GUARD) + "\n" + body
		var annotation: String = function["annotation"] + "\n" if not function["annotation"].is_empty() else ""
		source += "\n\n%sfunc %s(%s) -> %s:\n%s\n" % [annotation, function_name, ", ".join(params), function.get("returns", "void"), body]
	if trace:
		_use_helper(TRACE_HELPER)
	for helper: String in _helpers:
		source += "\n\n" + helper + "\n"
	if server:
		source += "\n\n" + SERVER_HELPER + "\n"
	return source


#region Script variables

## Validates constants, exports and shared variables and returns their
## declarations, grouped in that order.
func _script_declarations(graph: BrickscriptFlowGraph) -> Array[PackedStringArray]:
	var groups: Array[PackedStringArray] = [[], [], []]
	for variable: BrickscriptVariable in graph.variables:
		if variable == null:
			continue
		var where: String = "variable '%s'" % variable.name
		if variable.kind == Kind.CHAIN:
			errors.append("%s: chain variables aren't listed; nodes make them by naming their output" % where)
			continue
		if not _check_name(variable.name, where) or not Types.is_known(variable.type):
			if not Types.is_known(variable.type):
				errors.append("%s: unknown type %d" % [where, variable.type])
			continue
		if _script.has(variable.name):
			errors.append("%s: name used twice" % where)
			continue
		_script[variable.name] = {"type": variable.type, "writable": variable.kind == Kind.SHARED, "kind": variable.kind}
		var declaration: String = _declaration(variable, where)
		if not declaration.is_empty():
			groups[variable.kind].append(declaration)
	return groups


## What a Set Var's new name becomes: its `var_kind`, or (older graphs) its
## "keep between runs" flag.
static func set_var_kind(node: BrickscriptFlowNode) -> String:
	if node.settings.has(&"var_kind"):
		return str(node.settings[&"var_kind"])
	return "Shared" if node.settings.get(&"keep", true) else "Chain"


## Bricks that declare a script variable: Constant and Export bricks (no
## wires), Shared Set Vars no event reaches (their value is the starting
## value), and older Set Vars set to Constant / Export. Their value must be
## typed in.
func _declare_from_set_vars(graph: BrickscriptFlowGraph, groups: Array[PackedStringArray]) -> void:
	_declaring.clear()
	var reachable: Dictionary = _reachable_ids()
	for node: BrickscriptFlowNode in graph.nodes:
		if node == null or not _nodes.has(node.id) or _nodes[node.id] != node:
			continue
		var kind: String = Library.DECLARATIONS.get(node.type, "")
		if node.type == &"set_var":
			if Library.mode_of(node) != "Set":
				# Reads or adds to a variable made elsewhere; never declares one.
				continue
			kind = set_var_kind(node)
			if kind == Library.SET_VAR_KIND_SYNCED:
				if _server:
					errors.append("%s: a server brickscript can't make a Synced variable (only the server has it); make it in the local brickscript, and set it from here with Property (Set)" % _where(node, Library.get_definition(node.type)))
					continue
				_synced[str(node.settings.get(&"name", "")).strip_edges()] = true
				kind = "Shared"
			if kind == "Shared" and reachable.has(node.id) or kind == "Chain":
				continue
		elif kind.is_empty():
			continue
		_declaring[node.id] = true
		var where: String = _where(node, Library.get_definition(node.type))
		var name: String = str(node.settings.get(&"name", "")).strip_edges()
		if name.is_empty():
			errors.append("%s: needs a variable name" % where)
			continue
		if not _check_name(name, where):
			continue
		if _script.has(name):
			errors.append("%s: '%s' is declared twice" % [where, name])
			continue
		var data: Dictionary = Ops.input_of(node, &"value")
		if data.has("var"):
			errors.append("%s > value: a %s's value must be typed in (it is set before the game starts)" % [where, "starting" if kind == "Shared" else kind])
			continue
		var type: int = int(data.get("type", T.ANY))
		var problem: String = Types.literal_problem(type, data.get("value"))
		if not problem.is_empty():
			errors.append("%s > value: %s" % [where, problem])
			continue
		var group: int = ["Constant", "Export", "Shared"].find(kind)
		var literal: String = Types.literal(type, data["value"])
		if type == T.RESOURCE and kind == "Constant":
			# A constant needs a constant expression: preload (the file must exist).
			literal = "pre" + literal
		var node_type: Dictionary = NodeTypes.list_info_of_value(data["value"]) if type == T.LIST else NodeTypes.table_info_of_value(data["value"]) if type == T.TABLE else {}
		var line: String = "%s %s: %s = %s" % [["const", "@export var", "var"][group], name, _gd_type(type, node_type), literal]
		if type == T.NODE:
			match kind:
				"Constant":
					errors.append("%s: a Node can't be a Constant; make it an Export" % where)
					continue
				"Export":
					# Its Type limits what the Inspector accepts and what the
					# property dropdowns offer.
					node_type = _node_type_setting(node, where)
					line = "@export var %s: %s" % [name, NodeTypes.gd_class(node_type)]
				_:
					line = "@onready var %s: Node = %s" % [name, Types.literal(T.NODE, data["value"])]
					if str(data["value"]).strip_edges() == ".":
						node_type = _own_type if _script_node else _self_type
					elif _script_node and str(data["value"]).strip_edges() == "..":
						node_type = _self_type
		if kind == "Export" and node.type == &"export":
			var shown_on: String = _shown_on_path(node, where)
			if shown_on == "!":
				continue
			if not shown_on.is_empty():
				# Still a plain @export (the editor keeps its value like any
				# other); the editor's Inspector shows it on that node instead
				# of on the script node.
				_shown_on[name] = shown_on
		groups[group].append(line)
		_script[name] = {"type": type, "writable": kind == "Shared", "kind": [Kind.CONSTANT, Kind.EXPORT, Kind.SHARED][group], "node": node_type}


## [code, Node, node type] of a typed-in path in a script node, where paths
## start at the script node itself: Self ("." or blank) is the script node
## (its own variables), Self.Parent ("..") the node it works for
## (`_brickscript_body`), Self.Parent.UI its child UI. `stored` is the type
## the editor's picker found for the path.
func _script_node_path(path: String, stored: Dictionary) -> Array:
	var text: String = path.strip_edges()
	if text.is_empty() or text == ".":
		return ["self", T.NODE, _own_type]
	if text == "..":
		return ["_brickscript_body", T.NODE, _self_type]
	if text.begins_with("../"):
		# From the node it works for (typed): its parent, a child...
		return ["_brickscript_body.%s" % Types.literal(T.NODE, text.trim_prefix("../")), T.NODE, stored]
	return [Types.literal(T.NODE, text), T.NODE, stored]


## Whether a compiled function uses the node it acts for ("this node").
func _uses_body() -> bool:
	for function: Dictionary in _functions.values():
		for line: Variant in function["lines"]:
			if str(line).contains("_brickscript_body"):
				return true
	return false


## Export's Shown on: "" for this script node (a plain @export), else the
## path of the node whose Inspector shows it, from the node this brickscript
## acts for; "!" after an error.
func _shown_on_path(node: BrickscriptFlowNode, where: String) -> String:
	var picked: String = str(node.settings.get(&"shown_on", Library.EXPORT_SHOWN_ON[0]))
	match Library.EXPORT_SHOWN_ON.find(picked):
		0:
			return ""
		1:
			return "."
		2:
			var data: Dictionary = Ops.input_of(node, &"shown_node")
			var path: String = str(data.get("value", "")).strip_edges()
			if data.has("var") or path.is_empty():
				errors.append("%s > shown_node: type in the path of the node that shows it (e.g. Self.Parent)" % where)
				return "!"
			if _script_node:
				# Typed from Self (the script node); kept from the node it
				# works for (Self.Parent).
				if path == ".":
					return ""
				if path == "..":
					return "."
				if not path.begins_with("../"):
					errors.append("%s > shown_node: %s is inside the script node; pick Self.Parent or a node from there" % [where, Types.path_shown(path)])
					return "!"
				return path.trim_prefix("../")
			return path
	errors.append("%s > Shown on: '%s' isn't one of %s" % [where, picked, ", ".join(Library.EXPORT_SHOWN_ON)])
	return "!"


## The constant naming where Exports are shown (see _shown_on).
const SHOWN_ON_CONST: String = "_BRICKSCRIPT_SHOWN_ON"


## Node ids some event's exec wires reach.
func _reachable_ids() -> Dictionary:
	var reachable: Dictionary = {}
	var waiting: Array[int] = []
	for id: int in _nodes:
		if Library.get_definition(_nodes[id].type)["kind"] == Library.Kind.EVENT:
			waiting.append_array(_nodes[id].exits.values())
	while not waiting.is_empty():
		var id: int = waiting.pop_back()
		if id <= 0 or reachable.has(id) or not _nodes.has(id):
			continue
		reachable[id] = true
		waiting.append_array(_nodes[id].exits.values())
	return reachable


func _declaration(variable: BrickscriptVariable, where: String) -> String:
	var type_name: String = Types.GDSCRIPT_TYPES[variable.type]
	var value: Variant = variable.get_value()
	var head: String = ["const", "@export var", "var"][variable.kind]
	if variable.type == T.NODE:
		var path: String = str(value) if value != null else ""
		if variable.kind == Kind.CONSTANT:
			errors.append("%s: a Node can't be a constant; make it an Export" % where)
			return ""
		if variable.kind == Kind.EXPORT or path.is_empty():
			return "%s %s: Node" % [head, variable.name] if variable.kind == Kind.EXPORT else "var %s: Node = null" % variable.name
		return "@onready var %s: Node = %s" % [variable.name, Types.literal(T.NODE, path)]
	var code: String = ""
	if value == null:
		code = _default_code(variable.type)
	elif Types.EMPTY_ONLY.has(variable.type):
		code = var_to_str(value) if Types.of_value(value) == variable.type else _default_code(variable.type)
	else:
		var problem: String = Types.literal_problem(variable.type, value)
		if not problem.is_empty():
			errors.append("%s: %s" % [where, problem])
			return ""
		code = Types.literal(variable.type, value)
	return "%s %s: %s = %s" % [head, variable.name, type_name, code]


func _default_code(type: int) -> String:
	return "null" if type in [T.NODE, T.PLAYER] else var_to_str(Types.default_value(type))


## A name the user gave a variable must be a plain identifier that clashes
## with nothing in GDScript or the base class.
func _check_name(name: String, where: String) -> bool:
	if not name.is_valid_ascii_identifier():
		errors.append("%s: '%s' is not a valid name (use letters, digits and _, not starting with a digit)" % [where, name])
		return false
	if RESERVED_NAMES.has(name) or ClassDB.class_exists(name) or name.begins_with("_brickscript"):
		errors.append("%s: '%s' is a reserved word" % [where, name])
		return false
	if _is_base_member(name):
		errors.append("%s: '%s' is already part of %s" % [where, name, _base_type])
		return false
	return true


func _is_base_member(name: String) -> bool:
	if not ClassDB.class_exists(_base_type):
		return false
	if ClassDB.class_has_method(_base_type, name) or ClassDB.class_has_signal(_base_type, name) or ClassDB.class_has_integer_constant(_base_type, name):
		return true
	for property: Dictionary in ClassDB.class_get_property_list(_base_type):
		if property["name"] == name:
			return true
	return false

#endregion


#region Events and exec wires

func _compile_event(event: BrickscriptFlowNode, definition: Dictionary) -> void:
	_event_type = event.type
	var where: String = _where(event, definition)
	_chain.clear()
	_provided = definition.get("provides", {})
	_provided_nodes = definition.get("provided_nodes", {})
	_event_waits = false
	_event_stops = false
	var lines: Array = _function["lines"]
	var indent: int = 1
	var guard: String = definition.get("guard", "")
	if not guard.is_empty():
		# Fill the guard's {setting} placeholders with the typed-in settings.
		var codes: Dictionary[String, String] = {}
		for setting: Dictionary in definition.get("settings", []):
			var value: Variant = event.settings.get(setting["name"], setting["default"])
			if not value is String or (value as String).strip_edges().is_empty():
				errors.append("%s > %s: is empty" % [where, setting["name"]])
				return
			if setting["kind"] == "action" and not ProjectSettings.has_setting("input/" + value):
				warnings.append("%s > action: '%s' is not in the project's Input Map" % [where, value])
			codes[String(setting["name"])] = var_to_str((value as String).strip_edges() if setting["kind"] != "action" else value)
		for param: Array in definition["function_params"]:
			if RegEx.create_from_string("\\b%s\\b" % param[0]).search(guard) != null:
				_function["used"][param[0]] = true
		var condition: String = _fill(guard, codes)
		if str(event.settings.get(&"who", Library.INPUT_WHO[0])) == Library.INPUT_WHO[0] and definition.get("settings", []).has(Library.INPUT_WHO_SETTING) \
				and ProjectSettings.has_setting(NETWORK_AUTOLOAD_SETTING):
			# Networked, every machine has a copy of every player's node:
			# input drives only the one this machine owns.
			_use_helper(Library.OWNS_HELPER)
			condition += " and _brickscript_owns(%s, %s)" % [_self_code, var_to_str(_where(event, definition))]
		lines.append("\tif %s:%s" % [condition, marker(event.id)])
		indent = 2
	if trace:
		lines.append("\t".repeat(indent) + _trace_line(event.id))

	var exits: Array[int] = []
	for exit: StringName in event.exits:
		if String(exit).is_valid_int() and event.exits[exit] > 0:
			exits.append(int(String(exit)))
	exits.sort()
	var body: PackedStringArray = []
	for number: int in exits:
		if exits.size() > 1:
			body.append("\t".repeat(indent) + "# output %d" % number)
		body.append_array(_emit_from(event.exits[StringName(str(number))], indent, [], "%s > output %d" % [where, number]))
	var declarations: PackedStringArray = []
	for name: String in _chain:
		var type: int = _chain[name]["type"]
		declarations.append("\t".repeat(indent) + "var %s: %s = %s" % [_chain[name]["gd"], _gd_type(type, _chain[name].get("node", {})), _default_code(type)])
	body = declarations + body
	if body.is_empty():
		body.append("\t".repeat(indent) + "pass")
	if _event_waits and EVERY_FRAME_EVENTS.has(event.type):
		warnings.append("%s: it runs every frame, and each run waits on its own (Wait / Wait for signal), so the waits pile up. Use a Timer's signal, or a Shared variable that says it's already waiting." % where)
	if (_event_waits or _event_stops) and event.type != &"define_function":
		# It pauses (await): it runs in its own function, called without
		# waiting, so other events sharing this callback aren't held up. A
		# refused local change returns from it (_guarded()): only this chain
		# stops.
		var helper: String = "_brickscript_run_%d" % event.id
		var names: PackedStringArray = []
		for param: Array in definition["function_params"]:
			names.append(param[0])
			_function["used"][param[0]] = true
		var helper_lines: Array = []
		for line: String in body:
			helper_lines.append(line.substr(indent - 1))
		var used: Dictionary = {}
		for param: Array in definition["function_params"]:
			if RegEx.create_from_string("\\b%s\\b" % param[0]).search("\n".join(helper_lines)) != null:
				used[param[0]] = true
		var helper_params: Array = []
		for param: Array in definition["function_params"]:
			helper_params.append([param[0], "BrickscriptPlayer"] if _player_params(definition).has(param[0]) else param)
		_functions[helper] = {"params": helper_params, "lines": helper_lines, "used": used, "names": {}, "annotation": "", "prelude": ""}
		body = PackedStringArray(["\t".repeat(indent) + "%s(%s)" % [helper, ", ".join(names)]])
	lines.append_array(body)


## The code for the chain starting at node `id`, following "next" wires.
## `path` holds the nodes already on this path, to catch wires looping back.
## `stop`: where this chain ends here (a branch's join: written after the
## if / else, by the caller).
func _emit_from(id: int, indent: int, path: Array[int], where: String, stop: int = 0) -> PackedStringArray:
	var lines: PackedStringArray = []
	var current: int = id
	var on_path: Array[int] = path.duplicate()
	while current > 0 and current != stop:
		var node: BrickscriptFlowNode = _nodes.get(current, null)
		if node == null:
			errors.append("%s: wire leads to a missing node (%d)" % [where, current])
			break
		var definition: Dictionary = Library.get_definition(node.type)
		var node_where: String = _where(node, definition)
		if definition["kind"] == Library.Kind.EVENT:
			errors.append("%s: a wire can't lead into an event (%s)" % [where, node_where])
			break
		if definition["kind"] == Library.Kind.DECLARE:
			errors.append("%s: a wire can't lead into a %s (it has no wires)" % [where, node_where])
			break
		if on_path.has(current):
			errors.append("%s: wires loop back to %s (use a loop node to repeat)" % [where, node_where])
			break
		on_path.append(current)
		_reached[current] = true
		if definition.get("waits", false) or definition.get("can_wait", false) and str(node.settings.get(&"then", "")) == Library.ANIMATION_THEN[1]:
			_event_waits = true
		_record_scope(current)
		_line_count += 1
		if _line_count > MAX_LINES:
			if not errors.has("graph too big to write out"):
				errors.append("graph too big to write out")
			break
		var pad: String = "\t".repeat(indent)
		if trace and node.type != &"reroute":
			lines.append(pad + _trace_line(node.id))
		if node.type == &"if":
			var condition: String = _if_condition(node, definition, node_where)
			# On an error (recorded) keep going through both branches anyway:
			# later bricks still get their scopes and their own problems.
			lines.append(pad + "if %s:%s" % [condition if not condition.is_empty() else "false", marker(node.id)])
			var join: int = _join_of(node.exits.get(&"true", 0), node.exits.get(&"false", 0))
			var until: int = join if join > 0 else stop
			var branch: PackedStringArray = _emit_from(node.exits.get(&"true", 0), indent + 1, on_path, node_where + " > true", until)
			lines.append_array(branch if not branch.is_empty() else PackedStringArray([pad + "\tpass"]))
			if node.exits.get(&"false", 0) > 0 and node.exits[&"false"] != join:
				lines.append(pad + "else:")
				lines.append_array(_emit_from(node.exits[&"false"], indent + 1, on_path, node_where + " > false", until))
			if join <= 0:
				break
			# Both ways lead on to `join`: what follows is written once.
			current = join
			continue
		if definition.get("exits", []) == Library.LOOP_EXITS:
			var loop: PackedStringArray = _loop_start(node, definition, node_where)
			if loop.is_empty():
				# Error recorded; keep going for scopes and further problems.
				loop = PackedStringArray(["for _unused: int in range(0):"])
			lines.append(pad + loop[0] + marker(node.id))
			for line: String in loop.slice(1):
				lines.append(pad + "\t" + line + marker(node.id))
			_loop_depth += 1
			var body: PackedStringArray = _emit_outputs(Ops.outputs_of(node, &"loop"), indent + 1, on_path, node_where + " > loop body", 0)
			_loop_depth -= 1
			lines.append_array(body if not body.is_empty() or loop.size() > 1 else PackedStringArray([pad + "\tpass"]))
			var dones: Array[int] = Ops.outputs_of(node, &"done")
			if dones.size() > 1:
				lines.append_array(_emit_outputs(dones, indent, on_path, node_where + " > done", stop))
				break
			current = dones[0] if not dones.is_empty() else 0
			continue
		for line: String in _node_lines(node, definition, node_where):
			lines.append(pad + line + marker(node.id))
		var branch: Dictionary = definition.get("branch", {})
		if not branch.is_empty() and not node.exits.has(&"next"):
			# Exits like an If's: Raycast's Hit / Nothing hit, Walk to's
			# Arrived / Can't reach / Stopped. (A Raycast still wired through
			# the old "next" carries on after it either way.)
			var titles: Dictionary = definition.get("exit_titles", {})
			var wired: Array = (branch["cases"] as Array).filter(func(case: Array) -> bool: return node.exits.get(case[0], 0) > 0)
			if wired.is_empty():
				break
			var ids: Array[int] = []
			for case: Array in branch["cases"]:
				ids.append(node.exits.get(case[0], 0))
			var join: int = _join_of_all(ids)
			if join > 0 and ids.all(func(id: int) -> bool: return id == join):
				# Every exit wired to the same brick: it carries on either way.
				current = join
				continue
			var until: int = join if join > 0 else stop
			var written: Array = wired.filter(func(case: Array) -> bool: return node.exits[case[0]] != join)
			for i: int in written.size():
				var case: Array = written[i]
				# (The last of all the exits, every one wired: else.)
				var last: bool = i == written.size() - 1 and written.size() > 1 and written.size() == (branch["cases"] as Array).size()
				lines.append(pad + ("else:" if last else "%s %s:%s" % ["if" if i == 0 else "elif", case[1], marker(node.id)]))
				var body: PackedStringArray = _emit_from(node.exits[case[0]], indent + 1, on_path, node_where + " > " + str(titles.get(case[0], case[0])).to_lower(), until)
				lines.append_array(body if not body.is_empty() else PackedStringArray([pad + "\tpass"]))
			if join <= 0:
				break
			current = join
			continue
		var nexts: Array[int] = Ops.outputs_of(node, &"next")
		if nexts.size() > 1:
			lines.append_array(_emit_outputs(nexts, indent, on_path, node_where + " > next", stop))
			break
		current = nexts[0] if not nexts.is_empty() else 0
	return lines


## Several outputs of one exit (Next 1, Next 2...): each chain to its end
## (or `stop`), one after another.
func _emit_outputs(ids: Array[int], indent: int, path: Array[int], where: String, stop: int = 0) -> PackedStringArray:
	var lines: PackedStringArray = []
	for i: int in ids.size():
		lines.append_array(_emit_from(ids[i], indent, path, where + (" %d" % (i + 1) if ids.size() > 1 else ""), stop))
	return lines


## The brick a branch's two ways always lead on to (see _join_of_all()).
func _join_of(yes_id: int, no_id: int) -> int:
	return _join_of_all([yes_id, no_id])


## The brick all of a branch's ways (`ids`, one per exit; 0 = not wired: then
## there's none) always lead on to: every path from each reaches it (no dead
## end, Break, Continue, Return or several outputs on the way), the nearest
## one; 0 when there's none. Its chain is then written once, after the
## if / else, not once per way (which doubled the code at every such join).
func _join_of_all(ids: Array[int]) -> int:
	if ids.is_empty() or ids.any(func(id: int) -> bool: return id <= 0):
		return 0
	var first: int = ids[0]
	if ids.all(func(id: int) -> bool: return id == first):
		return first
	# Candidates nearest first: what the first way reaches, breadth first (not
	# into loop bodies: their chains end with each round).
	var order: Array[int] = [first]
	var seen: Dictionary = {first: true}
	var i: int = 0
	while i < order.size():
		var at: int = order[i]
		i += 1
		if ids.all(func(id: int) -> bool: return _always_reaches(id, at, {})):
			return at
		var node: BrickscriptFlowNode = _nodes.get(at, null)
		if node == null:
			continue
		for exit: StringName in node.exits:
			var target: int = node.exits[exit]
			if target > 0 and not seen.has(target) and Ops.exit_base(exit) != &"loop":
				seen[target] = true
				order.append(target)
	return 0


## Whether every path from `start` reaches `target` (see _join_of()).
## `memo`: branch bricks already worked out, for this target.
func _always_reaches(start: int, target: int, memo: Dictionary) -> bool:
	var current: int = start
	var visited: Dictionary = {}
	while true:
		if current == target:
			return true
		if current <= 0 or visited.has(current):
			return false
		if memo.has(current):
			return memo[current]
		visited[current] = true
		var node: BrickscriptFlowNode = _nodes.get(current, null)
		if node == null or node.type in [&"break", &"continue", &"return_value"]:
			return false
		var definition: Dictionary = Library.get_definition(node.type)
		var ways: Array[int] = []
		if node.type == &"if":
			ways = [node.exits.get(&"true", 0), node.exits.get(&"false", 0)]
		elif not definition.get("branch", {}).is_empty() and not node.exits.has(&"next"):
			for case: Array in definition["branch"]["cases"]:
				ways.append(node.exits.get(case[0], 0))
		if not ways.is_empty():
			var every: bool = ways.all(func(way: int) -> bool: return _always_reaches(way, target, memo))
			memo[current] = every
			return every
		var base: StringName = &"done" if definition.get("exits", []) == Library.LOOP_EXITS else &"next"
		var outputs: Array[int] = Ops.outputs_of(node, base)
		if outputs.size() != 1:
			return false
		current = outputs[0]
	return false

#endregion


#region Functions

## What this brickscript's functions give back and whether they wait (after
## compile()): name -> {"returns", "returns_node", "waits"}.
func function_info() -> Dictionary:
	return _function_info.duplicate(true)


## A brickscript file's functions and what they give back (a shared one
## called From: A file, a node's called From: A node), compiled once per
## version (by content: modified times are whole seconds). {"functions"
## (name -> Define Function node), "info" (its function_info(); empty when
## it's being compiled already: brickscripts calling each other), "server",
## "shared", "problem"}.
static func script_file(path: String) -> Dictionary:
	var version: String = FileAccess.get_md5(path) if FileAccess.file_exists(path) else ""
	if _shared_files.has(path) and _shared_files[path]["version"] == version:
		return _shared_files[path]
	var found: Dictionary = {"version": version, "functions": {}, "info": {}, "server": false, "shared": false, "problem": ""}
	var graph: BrickscriptFlowGraph = BrickFile.load_graph(path) if not version.is_empty() else null
	if graph == null:
		found["problem"] = "isn't a brickscript (no such file, or not a Brickscript graph)"
		return found
	found["functions"] = Ops.functions_of(graph)
	found["server"] = graph.context == &"server"
	found["shared"] = graph.shared
	if _compiling.has(path):
		# It calls back into one being compiled: its functions are known,
		# what they give back isn't (yet): those calls wait, untyped.
		return found
	var compiler: RefCounted = (load(SELF_PATH) as GDScript).new()
	compiler.source_path = path
	compiler.compile(graph)
	found["info"] = compiler.function_info()
	if not compiler.errors.is_empty():
		found["problem"] = "has problems: %s" % compiler.errors[0]
	_shared_files[path] = found
	return found


## A Define Function as an event: its GDScript function (FUNCTION_PREFIX +
## its name), its inputs as typed parameters the chain reads. {} on an
## error (recorded).
func _function_definition(node: BrickscriptFlowNode) -> Dictionary:
	var definition: Dictionary = Library.get_definition(node.type).duplicate()
	var where: String = _where(node, definition)
	var name: String = str(node.settings.get(&"name", "")).strip_edges()
	if not name.is_valid_ascii_identifier():
		errors.append("%s > name: '%s' is not a valid name (use letters, digits and _, not starting with a digit)" % [where, name])
		return {}
	if _defined.has(name):
		errors.append("%s > name: a function named '%s' is already defined here (brick %d)" % [where, name, _defined[name]])
		return {}
	_defined[name] = node.id
	var params: Array = []
	var provides: Dictionary = {}
	for param: Array in Ops.function_params(node):
		if not _check_name(param[0], where + " > input"):
			return {}
		if provides.has(param[0]):
			errors.append("%s > input: two inputs are named '%s'" % [where, param[0]])
			return {}
		provides[param[0]] = param[1]
		params.append([param[0], _gd_type(param[1], {})])
	definition["function"] = FUNCTION_PREFIX + name
	definition["function_params"] = params
	definition["provides"] = provides
	return definition


## After a function's chain: what its Returns give decides its return type
## (one type, or nothing), learned for the calls (_function_info).
func _finish_function(node: BrickscriptFlowNode) -> void:
	var where: String = _where(node, Library.get_definition(node.type))
	var name: String = str(node.settings.get(&"name", "")).strip_edges()
	var type: int = -1
	var node_type: Dictionary = {}
	var given: Array = _returns.filter(func(returned: Array) -> bool: return returned[0] >= 0)
	if not given.is_empty() and given.size() < _returns.size():
		errors.append("%s: some of its Returns give a value and some give nothing; a function gives one or the other" % where)
	# A Return giving Anything (a value whose type isn't known: a call of
	# this function itself, on the first pass) takes the others' type.
	var typed: Array = given.filter(func(returned: Array) -> bool: return returned[0] != T.ANY)
	if typed.is_empty() and not given.is_empty():
		type = T.ANY
	for returned: Array in typed:
		if type < 0:
			type = returned[0]
			node_type = returned[1]
		elif returned[0] != type:
			if T.NUMBER in [type, returned[0]] and T.WHOLE in [type, returned[0]]:
				type = T.NUMBER
			else:
				errors.append("%s: this Return gives a %s, another of the function gives a %s; a function gives one type" % [returned[2], Types.type_name(returned[0]), Types.type_name(type)])
	_function["plain"] = true
	_function["returns"] = "void" if type < 0 else _gd_type(type, node_type)
	var lines: Array = _function["lines"]
	if type >= 0 and (lines.is_empty() or not str(lines[-1]).begins_with("\treturn")):
		# A chain that ends without a Return gives the type's default.
		lines.append("\treturn %s" % _default_code(type))
	var info: Dictionary = {"returns": type, "returns_node": node_type, "waits": _event_waits}
	if _function_info.get(name, {}) != info:
		_settled = false
	_function_info[name] = info


func _return(node: BrickscriptFlowNode, definition: Dictionary, where: String) -> PackedStringArray:
	if _event_type != &"define_function":
		errors.append("%s: Return only works in a Define Function's chain (it ends that function)" % where)
		return []
	if str(node.settings.get(&"gives", Library.RETURN_GIVES[0])) == Library.RETURN_GIVES[1]:
		_returns.append([-1, {}, where])
		return ["return"]
	var value: Array = _input(node, definition["inputs"][0], where)
	if value.is_empty():
		return []
	_returns.append([value[1], value[2] if value.size() > 2 else {}, where])
	return ["return %s" % value[0]]


func _call_function(node: BrickscriptFlowNode, where: String) -> PackedStringArray:
	var name: String = str(node.settings.get(&"function", "")).strip_edges()
	var output: String = node.output_name.strip_edges()
	var from: String = str(node.settings.get(&"from", Library.FUNCTION_FROM[0]))
	var functions: Dictionary = _function_nodes
	var infos: Dictionary = _function_info
	# From: A node without its brickscript picked: called by name, checked
	# when the game runs.
	var by_name: bool = false
	var path: String = ""
	if from == Library.FUNCTION_FROM[1]:
		path = str(node.settings.get(&"file", "")).strip_edges()
		if path.is_empty():
			errors.append("%s > file: pick a shared brickscript (.brickshared)" % where)
			return []
		if not BrickFile.is_shared_path(path):
			errors.append("%s > file: %s isn't a shared brickscript (.brickshared)" % [where, path.get_file()])
			return []
		var shared: Dictionary = script_file(path)
		if not str(shared["problem"]).is_empty():
			errors.append("%s > file: %s %s" % [where, path.get_file(), shared["problem"]])
			return []
		if shared["server"] and not _server:
			errors.append("%s > file: %s is Used by: Server only, so only server brickscripts can call it" % [where, path.get_file()])
			return []
		functions = shared["functions"]
		infos = shared["info"]
	elif from == Library.FUNCTION_FROM[2]:
		path = str(node.settings.get(&"function_script", "")).strip_edges()
		by_name = path.is_empty()
		if not by_name:
			var other: Dictionary = script_file(path)
			if not str(other["problem"]).is_empty():
				errors.append("%s > function_script: %s %s" % [where, path.get_file(), other["problem"]])
				return []
			if other["shared"] or other["server"] != _server:
				errors.append("%s > function_script: a %s brickscript calls the functions of a node's %s brickscript, not %s" % [where, "server" if _server else "local",
					"server" if _server else "local", path.get_file()])
				return []
			functions = other["functions"]
			infos = other["info"]
	if name.is_empty():
		errors.append("%s > function: pick a function" % where)
		return []
	if not by_name and not functions.has(name):
		errors.append("%s > function: %s has no function named '%s' (a Define Function brick makes one)" % [where, "this brickscript" if path.is_empty() else path.get_file(), name])
		return []
	var params: Array = Ops.function_params(functions[name]) if not by_name else []
	if not by_name and Ops.row_count(node) != params.size():
		var names: PackedStringArray = []
		for param: Array in params:
			names.append("%s: %s" % [param[0], Types.type_name(param[1])])
		errors.append("%s: %s takes %d value(s) (%s), not %d" % [where, name, params.size(), ", ".join(names), Ops.row_count(node)])
		return []
	var args: PackedStringArray = []
	for i: int in Ops.row_count(node):
		var given: Array = _input(node, Ops.input_spec(node.type, StringName("arg_%d" % (i + 1))), where)
		if given.is_empty():
			return []
		var wanted: int = params[i][1] if not by_name else T.ANY
		var code: String = given[0]
		if wanted != T.ANY and given[1] != T.ANY and given[1] != wanted:
			if wanted == T.NUMBER and given[1] == T.WHOLE:
				code = "float(%s)" % code
			else:
				errors.append("%s > arg_%d: %s's %s takes a %s, not a %s" % [where, i + 1, name, params[i][0], Types.type_name(wanted), Types.type_name(given[1])])
				return []
		args.append(code)
	var info: Dictionary = infos.get(name, {})
	# This brickscript's own functions are learned pass by pass. Another
	# file's that aren't known (called by name, or a brickscript calling back
	# into this one) are waited for anyway: an await on a value that isn't
	# waiting just gives it.
	var waits: bool = bool(info.get("waits", from != Library.FUNCTION_FROM[0]))
	if waits:
		# It waits, so the chain calling it does too.
		_event_waits = true
	var call: String = ""
	match from:
		Library.FUNCTION_FROM[1]:
			_use_helper(Library.SHARED_HELPER)
			call = "%s_brickscript_shared(%s).%s%s(%s)" % ["await " if waits else "", var_to_str(path), FUNCTION_PREFIX, name, ", ".join(args)]
		Library.FUNCTION_FROM[2]:
			var target: Array = _input(node, Ops.input_spec(node.type, &"node"), where)
			if target.is_empty():
				return []
			_use_helper(Library.NODE_FUNCTION_HELPER)
			call = "%s_brickscript_%s_node(%s, %s, %s, %s, [%s], %s)" % ["await " if waits else "", "await" if waits else "call", target[0], var_to_str(path),
				"true" if _server else "false", var_to_str(StringName(FUNCTION_PREFIX + name)), ", ".join(args), _brick_label(node)]
		_:
			call = "%s%s%s(%s)" % ["await " if waits else "", FUNCTION_PREFIX, name, ", ".join(args)]
	if output.is_empty():
		return [call]
	if not info.is_empty() and int(info["returns"]) < 0:
		warnings.append("%s: %s gives nothing back (no Return with a value), so its Output stays empty" % [where, name])
		return [call]
	var type: int = int(info.get("returns", T.ANY))
	return _output(node, call, type, where, info.get("returns_node", {}))

#endregion


#region Nodes

func _node_lines(node: BrickscriptFlowNode, definition: Dictionary, where: String) -> PackedStringArray:
	if node.type == &"set_var":
		return _set_var(node, definition, where)
	if node.type == &"unpack_table":
		return _unpack_table(node, definition, where)
	if Library.ANIMATION_BRICKS.has(node.type):
		return _animation_brick(node, definition, where)
	if node.type in [&"tween_property", &"stop_tweens"]:
		return _tween_brick(node, definition, where)
	if node.type == &"invoke_server":
		var message: String = str(node.settings.get(&"message", "")).strip_edges()
		if message.is_empty():
			errors.append("%s > message: is empty" % where)
			return []
		var codes: Dictionary[String, String] = {}
		for spec: Dictionary in Ops.input_specs(node):
			var given: Array = _input(node, spec, where)
			if given.is_empty():
				return []
			codes[String(spec["name"])] = given[0]
		_use_helper(Library.INVOKE_HELPER)
		_use_helper(Library.WIRE_HELPER)
		var call: String = "await _brickscript_invoke(%s, %s, %s)" % [var_to_str(message), _join(node, definition, codes), _brick_label(node)]
		return [call] if node.output_name.strip_edges().is_empty() else _output(node, call, T.ANY, where)
	if node.type == &"answer_client":
		if _event_type != &"event_client_invokes":
			errors.append("%s: Answer only works in an On Client Invoked chain (it answers that question)" % where)
			return []
		if _event_waits:
			errors.append("%s: Answer can't come after a Wait (the question's own run is over by then)" % where)
			return []
		var value: Array = _input(node, definition["inputs"][0], where)
		if value.is_empty():
			return []
		for param: String in ["sender", "request", "asker"]:
			_function["used"][param] = true
		_use_helper(Library.ANSWER_HELPER)
		_use_helper(Library.PLAYER_NODE_HELPER)
		return ["_brickscript_answer(asker, _brickscript_peer(sender), request, %s)" % value[0]]
	if node.type == &"reroute":
		# Only bends a wire: what it leads to runs next.
		return []
	if node.type == &"return_value":
		return _return(node, definition, where)
	if node.type == &"call_function":
		return _call_function(node, where)
	if node.type == &"break" or node.type == &"continue":
		if _loop_depth == 0:
			errors.append("%s: only works inside a loop's Loop body (For each, Repeat, While)" % where)
			return []
		return [String(node.type)]
	if Library.NODE_BRICKS.has(node.type):
		var made: PackedStringArray = _node_brick(node, definition, where)
		if made.is_empty() and Library.node_has_output(node) and not node.use_var:
			_make_anyway(node.output_name.strip_edges(), false)
		return made
	if node.type == &"formula":
		var formula: Array = _formula(node, where)
		if formula.is_empty():
			if not node.use_var:
				_make_anyway(node.output_name.strip_edges(), false)
			return []
		return _output(node, formula[0], formula[1], where)
	var codes: Dictionary[String, String] = {}
	var types: Dictionary[String, int] = {}
	var infos: Dictionary[String, Dictionary] = {}
	for setting: Dictionary in definition.get("settings", []):
		if setting["kind"] in ["text", "group", "action"]:
			var text: String = str(node.settings.get(setting["name"], setting["default"])).strip_edges()
			if setting["kind"] == "action" and not text.is_empty() and not ProjectSettings.has_setting("input/" + text):
				warnings.append("%s > %s: '%s' is not in the project's Input Map" % [where, setting["name"], text])
			if text.is_empty() and setting.get("required", false):
				errors.append("%s > %s: is empty" % [where, setting["name"]])
				return []
			codes[String(setting["name"])] = var_to_str(text)
		elif setting["kind"] == "choice" and setting.has("codes"):
			# A choice that becomes code (e.g. Give To's As: true / false).
			var picked: String = str(node.settings.get(setting["name"], setting["default"]))
			codes[String(setting["name"])] = str(setting["codes"].get(picked, setting["codes"][setting["default"]]))
	for spec: Dictionary in Ops.input_specs(node):
		if not Ops.input_shown(node, spec["name"]):
			# Not in use (e.g. Fire Clients' client while sending to all: -1).
			codes[String(spec["name"])] = str(spec.get("unused", "0"))
			continue
		var given: Array = _input(node, spec, where)
		if not given.is_empty() and spec.has("node_class") and not _is_class(given[2], spec["node_class"]):
			errors.append("%s > %s: needs a %s, not a %s" % [where, spec["name"], spec["node_class"], NodeTypes.describe(given[2])])
			given = []
		if not given.is_empty() and spec.get("node_script", "") == Library.TERRAIN_SCRIPT and not _could_be_terrain(given[2]):
			errors.append("%s > %s: needs a Terrain (the Terrain Engine plugin's node), not a %s" % [where, spec["name"], NodeTypes.describe(given[2])])
			given = []
		if given.is_empty():
			if Library.node_has_output(node) and not node.use_var:
				_make_anyway(node.output_name.strip_edges(), false)
			return []
		codes[String(spec["name"])] = _peer_code(given) if spec["types"] == [T.PLAYER] else given[0]
		if node.type == &"print" and given[1] == T.PLAYER:
			_use_helper(Library.PLAYER_TEXT_HELPER)
			codes[String(spec["name"])] = "_brickscript_player_text(%s)" % given[0]
		types[String(spec["name"])] = given[1]
		infos[String(spec["name"])] = given[2]
	match node.type:
		&"mesh_vertices":
			return _mesh_vertices(node, codes, types, infos, where)
		&"make_list":
			var made: PackedStringArray = _make_list(node, definition, codes, types, infos, where)
			if made.is_empty() and not node.use_var:
				_make_anyway(node.output_name.strip_edges(), false)
			return made
		&"get_item":
			# An item of a typed List is typed (Number, Label...).
			return _output(node, _fill(definition["result"], codes), NodeTypes.list_item(infos["list"]), where, infos["list"].get("items", {}))
		&"make_table":
			var made_table: PackedStringArray = _make_table(node, definition, codes, types, infos, where)
			if made_table.is_empty() and not node.use_var:
				_make_anyway(node.output_name.strip_edges(), false)
			return made_table
		&"get_value":
			# A typed Table's values are typed; its key and fallback must fit.
			var keys: Dictionary = NodeTypes.table_keys(infos["table"])
			var values: Dictionary = NodeTypes.table_values(infos["table"])
			var holder: String = NodeTypes.describe_table(infos["table"])
			if not _list_takes(keys, [codes["key"], types["key"], infos["key"]], where + " > key", holder + "'s keys") \
					or not _list_takes(values, [codes["fallback"], types["fallback"], infos["fallback"]], where + " > fallback", holder + "'s values"):
				return []
			return _output(node, _fill(definition["result"], codes), NodeTypes.list_item(values), where, values.get("items", {}))
		&"table_set":
			var keys: Dictionary = NodeTypes.table_keys(infos["table"])
			var values: Dictionary = NodeTypes.table_values(infos["table"])
			var holder: String = NodeTypes.describe_table(infos["table"])
			if not _list_takes(keys, [codes["key"], types["key"], infos["key"]], where + " > key", holder + "'s keys") \
					or not _list_takes(values, [codes["value"], types["value"], infos["value"]], where + " > value", holder + "'s values"):
				return []
			if NodeTypes.list_item(values) == T.WHOLE and types["value"] == T.NUMBER:
				codes["value"] = "roundi(%s)" % codes["value"]
		&"list_add":
			if not _list_takes(infos["list"], [codes["value"], types["value"], infos["value"]], where + " > value"):
				return []
			if NodeTypes.list_item(infos["list"]) == T.WHOLE and types["value"] == T.NUMBER:
				codes["value"] = "roundi(%s)" % codes["value"]
	if definition.has("helper") and not _helpers.has(definition["helper"]):
		_helpers.append(definition["helper"])
	for helper: String in definition.get("helpers", []):
		_use_helper(helper)
	# The brick, for errors its helper reports when the game runs.
	codes["brick"] = _brick_label(node)
	# A server brickscript's (e.g. a mesh it builds goes to every machine).
	codes["server"] = str(_server)
	if definition.has("code"):
		if definition.has("join"):
			codes["values"] = _join(node, definition, codes)
		var guard: String = ""
		if definition.has("local_target"):
			var target: String = String(definition["local_target"])
			guard = _local_guard(node, [codes[target], types[target], infos[target]], where)
			if guard == LOCAL_REFUSED:
				return []
		return _guarded(guard, _fill(definition["code"], codes))
	if definition.has("join"):
		return _output(node, _join(node, definition, codes), definition["returns"], where)
	var returns: Variant = definition["returns"]
	var divide: bool = returns is StringName and returns == &"divide"
	var type: int = returns if returns is int else _arith_type(node, types, divide, where)
	if type < 0:
		if not node.use_var:
			_make_anyway(node.output_name.strip_edges(), false)
		return []
	if divide and types["a"] == T.WHOLE and types["b"] == T.WHOLE:
		codes["a"] = "float(%s)" % codes["a"]
	if type == T.PLAYER:
		# (The engine's helpers give the player's number: its node.)
		_use_helper(Library.PLAYER_NODE_HELPER)
		return _output(node, "_brickscript_player(%s)" % _fill(definition["result"], codes), type, where)
	return _output(node, _fill(definition["result"], codes), type, where)


## If's condition: A alone for "is true" / "is false" (a Bool) or "is null" /
## "is not null" (a Node, Resource or Anything; freed objects count; a Player:
## "no player", 0), or
## A <operator> B. "" on error (recorded).
func _if_condition(node: BrickscriptFlowNode, definition: Dictionary, where: String) -> String:
	var operator: String = str(node.settings.get(&"operator", "is true"))
	if not Library.IF_OPERATORS.has(operator):
		errors.append("%s: unknown comparison '%s'" % [where, operator])
		return ""
	var a: Array = _input(node, definition["inputs"][0], where)
	if a.is_empty():
		return ""
	if Library.IF_NULL.has(operator):
		var negate: String = "" if operator == "is null" else "not "
		match a[1]:
			T.NODE, T.RESOURCE:
				return ("is_instance_valid(%s)" if negate else "not is_instance_valid(%s)") % a[0]
			T.ANY:
				_use_helper(Library.IS_NULL_HELPER)
				return "%s_brickscript_is_null(%s)" % [negate, a[0]]
			T.PLAYER:
				return ("%s != null" if negate else "%s == null") % a[0]
		errors.append("%s > a: '%s' is %s, which is never null; \"%s\" needs a Node, Resource, Player or Anything" % [where, a[0], _a_type(a[1]), operator])
		return ""
	if Library.IF_UNARY.has(operator):
		if a[1] != T.BOOL:
			errors.append("%s > a: '%s' is %s; \"%s\" needs a Bool (pick a comparison like > or == instead)" % [where, a[0], _a_type(a[1]), operator])
			return ""
		return a[0] if operator == "is true" else "not %s" % a[0]
	var b: Array = _input(node, definition["inputs"][1], where)
	if b.is_empty():
		return ""
	if Library.IF_ORDERING.has(operator):
		var a_ok: bool = Types.NUMERIC.has(a[1]) or a[1] == T.ANY
		var b_ok: bool = Types.NUMERIC.has(b[1]) or b[1] == T.ANY
		if not a_ok or not b_ok:
			errors.append("%s: %s only compares numbers (got %s and %s)" % [where, operator, _a_type(a[1]), _a_type(b[1])])
			return ""
	elif not Types.fits(b[1], a[1]):
		errors.append("%s: can't compare %s with %s" % [where, _a_type(a[1]), _a_type(b[1])])
		return ""
	return "%s %s %s" % [a[0], operator, b[0]]


func _a_type(type: int) -> String:
	return _a_type_text(Types.type_name(type))


func _a_type_text(type_name: String) -> String:
	return ("an " if "AEIOU".contains(type_name[0]) else "a ") + type_name


## Add / Subtract / Multiply / Divide: numbers give a number (two whole
## numbers a whole number, except Divide); vectors of one kind give that
## vector; Multiply and Divide also scale a vector by a number.
func _arith_type(node: BrickscriptFlowNode, types: Dictionary[String, int], divide: bool, where: String) -> int:
	var a: int = types["a"]
	var b: int = types["b"]
	if a == T.ANY or b == T.ANY:
		# Items from Lists / Tables: GDScript works it out at runtime.
		return T.ANY
	if Types.NUMERIC.has(a) and Types.NUMERIC.has(b):
		return T.WHOLE if a == T.WHOLE and b == T.WHOLE and not divide else T.NUMBER
	if a == b and Types.VECTORS.has(a):
		return a
	var scales: bool = node.type == &"multiply" or divide
	if scales and Types.VECTORS.has(a) and Types.NUMERIC.has(b):
		return a
	if node.type == &"multiply" and Types.NUMERIC.has(a) and Types.VECTORS.has(b):
		return b
	errors.append("%s: can't %s a %s and a %s" % [where, String(node.type), Types.type_name(a), Types.type_name(b)])
	return -1


## Make list / Make table: `join`'s row once per row of repeated inputs.
func _join(node: BrickscriptFlowNode, definition: Dictionary, codes: Dictionary[String, String]) -> String:
	var join: Dictionary = definition["join"]
	var rows: PackedStringArray = []
	for row: int in range(1, Ops.row_count(node) + 1):
		var row_codes: Dictionary[String, String] = {}
		for spec: Dictionary in definition["variadic"]["inputs"]:
			row_codes[String(spec["name"])] = codes["%s_%d" % [spec["name"], row]]
		rows.append(_fill(join["row"], row_codes))
	return join["open"] + join["separator"].join(rows) + join["close"]


## Make list: a List of what its items are (see NodeTypes.list_info_of_items),
## or of the type its Items setting picks (every item must fit it).
func _make_list(node: BrickscriptFlowNode, definition: Dictionary, codes: Dictionary[String, String], types: Dictionary[String, int], infos: Dictionary[String, Dictionary], where: String) -> PackedStringArray:
	var rows: Array[String] = []
	var entries: Array = []
	for row: int in range(1, Ops.row_count(node) + 1):
		rows.append("item_%d" % row)
		entries.append([types[rows[-1]], infos[rows[-1]]])
	var choice: String = str(node.settings.get(&"items", Library.LIST_ITEMS_AUTO))
	var list: Dictionary = {}
	if choice == Library.LIST_ITEMS_AUTO:
		list = NodeTypes.list_info_of_items(entries)
	else:
		var item: int = Types.NAMES.find_key(choice) if Types.NAMES.values().has(choice) else -1
		if item < 0:
			errors.append("%s > items: unknown item type '%s'" % [where, choice])
			return []
		list = NodeTypes.list_info(item)
		for i: int in rows.size():
			if not _list_takes(list, [codes[rows[i]], entries[i][0], entries[i][1]], where + " > " + rows[i]):
				return []
	for i: int in rows.size():
		if NodeTypes.list_item(list) == T.WHOLE and entries[i][0] == T.NUMBER:
			codes[rows[i]] = "roundi(%s)" % codes[rows[i]]
		elif NodeTypes.list_item(list) == T.NUMBER and entries[i][0] == T.WHOLE:
			codes[rows[i]] = "float(%s)" % codes[rows[i]]
	return _output(node, _join(node, definition, codes), T.LIST, where, list)


## Make table: a Table of what its keys and values are (each side like Make
## list's items: Auto from the rows, or the type picked in Keys / Values).
func _make_table(node: BrickscriptFlowNode, definition: Dictionary, codes: Dictionary[String, String], types: Dictionary[String, int], infos: Dictionary[String, Dictionary], where: String) -> PackedStringArray:
	var sides: Array[Dictionary] = []
	for side: String in ["key", "value"]:
		var rows: Array[String] = []
		var entries: Array = []
		for row: int in range(1, Ops.row_count(node) + 1):
			rows.append("%s_%d" % [side, row])
			entries.append([types[rows[-1]], infos[rows[-1]]])
		var choice: String = str(node.settings.get(StringName(side + "s"), Library.LIST_ITEMS_AUTO))
		var info: Dictionary = {}
		if choice == Library.LIST_ITEMS_AUTO:
			info = NodeTypes.list_info_of_items(entries)
		else:
			var item: int = Types.NAMES.find_key(choice) if Types.NAMES.values().has(choice) else -1
			if item < 0:
				errors.append("%s > %ss: unknown type '%s'" % [where, side, choice])
				return []
			info = NodeTypes.list_info(item)
			for i: int in rows.size():
				if not _list_takes(info, [codes[rows[i]], entries[i][0], entries[i][1]], where + " > " + rows[i], "a Table of %s %ss" % [NodeTypes.describe_list(info).trim_prefix("List of "), side]):
					return []
		for i: int in rows.size():
			if NodeTypes.list_item(info) == T.WHOLE and entries[i][0] == T.NUMBER:
				codes[rows[i]] = "roundi(%s)" % codes[rows[i]]
			elif NodeTypes.list_item(info) == T.NUMBER and entries[i][0] == T.WHOLE:
				codes[rows[i]] = "float(%s)" % codes[rows[i]]
		sides.append(info)
	return _output(node, _join(node, definition, codes), T.TABLE, where, NodeTypes.table_info(sides[0], sides[1]))


## Whether `value` ([code, type, node type]) can go in a List of `list`'s
## items (Anything always can; GDScript checks it when the game runs);
## records an error if not (naming `holder`: the List, or a Table's keys /
## values).
func _list_takes(list: Dictionary, value: Array, where: String, holder: String = "") -> bool:
	var item: int = NodeTypes.list_item(list)
	var items: Dictionary = list.get("items", {})
	var fits: bool = Types.fits(value[1], item)
	if fits and item == T.NODE and value[1] == T.NODE:
		fits = NodeTypes.fits(value[2], items)
	elif fits and item == T.RESOURCE and value[1] == T.RESOURCE:
		fits = _resource_fits(value[2], items.get("class", &""))
	if not fits:
		var given: String = NodeTypes.describe(value[2]) if value[1] == T.NODE and not value[2].is_empty() else Types.type_name(value[1])
		errors.append("%s: %s can't hold %s" % [where, holder if not holder.is_empty() else "a " + NodeTypes.describe_list(list), _a_type_text(given)])
	return fits


## A loop's first line and the lines that fill its named variables each time
## round; [] on error (recorded). It counts with a hidden `_i_<node id>` (or
## `_k_<node id>` for keys), so the named variables keep their last values
## after the loop and nested loops never clash.
func _loop_start(node: BrickscriptFlowNode, definition: Dictionary, where: String) -> PackedStringArray:
	if node.type == &"while":
		return _while_start(node, definition, where)
	var source: Array = _input(node, definition["inputs"][0], where)
	if source.is_empty():
		return []
	var counter: String = "_i_%d" % node.id
	var start: PackedStringArray = []
	var names: Array = []
	match node.type:
		&"for_each":
			start.append("for %s: int in range(len(%s)):" % [counter, source[0]])
			# A typed List (List of Number, List of Label...) types its items.
			var list: Dictionary = source[2] if source.size() > 2 else {}
			names = [[&"index_name", counter, T.WHOLE], [&"item_name", "%s[%s]" % [source[0], counter], NodeTypes.list_item(list), list.get("items", {})]]
			# A node freed while still in the List (an enemy that died) is
			# passed over: it can't be used (user, 2026-11-03).
			if NodeTypes.list_item(list) in [T.NODE, T.ANY]:
				start.append(_skip_freed("%s[%s]" % [source[0], counter]))
		&"for_each_pair":
			counter = "_k_%d" % node.id
			start.append("for %s: Variant in %s:" % [counter, source[0]])
			# A typed Table types its keys and values.
			var table: Dictionary = source[2] if source.size() > 2 else {}
			var keys: Dictionary = NodeTypes.table_keys(table)
			var values: Dictionary = NodeTypes.table_values(table)
			names = [[&"key_name", counter, NodeTypes.list_item(keys), keys.get("items", {})], [&"value_name", "%s[%s]" % [source[0], counter], NodeTypes.list_item(values), values.get("items", {})]]
			if NodeTypes.list_item(keys) in [T.NODE, T.ANY]:
				start.append(_skip_freed(counter))
			if NodeTypes.list_item(values) in [T.NODE, T.ANY]:
				start.append(_skip_freed("%s[%s]" % [source[0], counter]))
		&"repeat":
			var times: String = "roundi(%s)" % source[0] if source[1] == T.NUMBER else source[0]
			start.append("for %s: int in range(%s):" % [counter, times])
			names = [[&"index_name", counter, T.WHOLE]]
	for entry: Array in names:
		var name: String = str(node.settings.get(entry[0], "")).strip_edges()
		if name.is_empty():
			continue
		var item_type: Dictionary = entry[3] if entry.size() > 3 else {}
		if not _exists(name):
			if not _check_name(name, where + " > " + String(entry[0]).trim_suffix("_name")):
				return []
			_new_chain_variable(name, entry[2], item_type)
		var assigned: PackedStringArray = _assign(name, entry[1], entry[2], where, item_type)
		if assigned.is_empty():
			return []
		start.append_array(assigned)
	return start


## A loop's line that passes over a freed node (null and other values go on).
static func _skip_freed(value: String) -> String:
	return "if typeof(%s) == TYPE_OBJECT and not is_instance_valid(%s): continue" % [value, value]


## Play / Stop (UI) animation: through the helpers (the server's on every
## machine, the UI ones checked to only animate local-only nodes); Then:
## Wait until it ends awaits it.
func _animation_brick(node: BrickscriptFlowNode, definition: Dictionary, where: String) -> PackedStringArray:
	var player: Array = _input(node, definition["inputs"][0], where)
	if player.is_empty():
		return []
	var known: StringName = player[2].get("class", &"Node")
	if known != &"Node" and not Library.ANIMATION_CLASSES.any(func(wanted: StringName) -> bool: return ClassDB.is_parent_class(known, wanted)):
		errors.append("%s > player: a %s can't play animations: it needs an AnimationPlayer, AnimatedSprite2D or AnimatedSprite3D" % [where, NodeTypes.describe(player[2])])
		return []
	var ui: bool = node.type in [&"play_ui_animation", &"stop_ui_animation"]
	_use_helper(Library.CAN_ANIMATE_HELPER)
	_use_helper(Library.PLAY_HERE_HELPER)
	if ui:
		_use_helper(Library.LOCAL_ONLY_HELPER)
		_use_helper(Library.UI_ANIMATION_HELPER)
	else:
		_use_helper(Library.PLAY_ANIMATION_HELPER)
	var brick: String = _brick_label(node)
	if node.type in [&"stop_animation", &"stop_ui_animation"]:
		var pause: String = "true" if str(node.settings.get(&"how", "Stop")) == "Pause" else "false"
		return ["%s(%s, %s, %s)" % ["_brickscript_stop_ui_animation" if ui else "_brickscript_stop_animation", player[0], pause, brick]]
	var animation: String = str(node.settings.get(&"animation", "")).strip_edges()
	if animation.is_empty():
		errors.append("%s > Animation: pick one of the node's animations" % where)
		return []
	var speed: Array = _input(node, definition["inputs"][1], where)
	if speed.is_empty():
		return []
	var backwards: String = "true" if str(node.settings.get(&"direction", "Forwards")) == "Backwards" else "false"
	var name: String = "&" + var_to_str(animation)
	var lines: PackedStringArray = ["%s(%s, %s, %s, %s, %s)" % ["_brickscript_play_ui_animation" if ui else "_brickscript_play_animation", player[0], name, speed[0], backwards, brick]]
	if str(node.settings.get(&"then", "")) == Library.ANIMATION_THEN[1]:
		lines.append("await _brickscript_animation_end(%s, %s)" % [player[0], name])
	return lines


## Tween property / Stop tweens: the property is checked as Set property's
## (writable; a local brickscript only on what it may change); a server
## brickscript's run on every machine (`everywhere`); Then: Wait until it ends
## awaits the tween.
func _tween_brick(node: BrickscriptFlowNode, definition: Dictionary, where: String) -> PackedStringArray:
	var target: Array = _input(node, definition["inputs"][0], where)
	if target.is_empty():
		return []
	var everywhere: String = "true" if _server else "false"
	if node.type == &"stop_tweens":
		var stop_guard: String = _local_guard(node, target, where)
		if stop_guard == LOCAL_REFUSED:
			return []
		_use_helper(Library.TWEEN_HELPER)
		return _guarded(stop_guard, "_brickscript_stop_tweens(%s, %s, %s)" % [target[0], everywhere, _brick_label(node)])
	var name: String = str(node.settings.get(&"property", "")).strip_edges()
	if not name.is_valid_ascii_identifier():
		errors.append("%s > property: %s" % [where, "pick one" if name.is_empty() else "'%s' is not a valid name" % name])
		return []
	var member: Dictionary = _find_member(target[2], name, "property")
	if member.is_empty():
		warnings.append("%s > property: '%s' isn't known on %s; it's tweened by name when the game runs" % [where, name, _describe(target[2])])
		member = {"name": name, "kind": "property", "type": T.ANY, "node": {}, "native": false, "writable": true}
	if not _can_set(member, target, where):
		return []
	if member["type"] != T.ANY and not Library.TWEEN_TYPES.has(member["type"]):
		errors.append("%s: '%s' is a %s; only numbers, vectors and colors can be tweened (use Property (Set))" % [where, name, Types.type_name(member["type"])])
		return []
	if _is_character(target[2]) and Library.CHARACTER_PROPERTIES.has(name):
		errors.append("%s: a character's %s goes through Property (Set) (it reaches the machine that moves it); it can't be tweened" % [where, name])
		return []
	var to: Array = _input(node, definition["inputs"][1], where)
	if to.is_empty() or not _value_fits(to, member, where + " > to"):
		return []
	var value: String = _rounded(to, member)
	if member["type"] == T.NUMBER and to[1] == T.WHOLE:
		# A tween needs the same type at both ends.
		value = "float(%s)" % value
	var codes: Array[String] = []
	for spec: Dictionary in definition["inputs"].slice(2):
		var given: Array = _input(node, spec, where)
		if given.is_empty():
			return []
		codes.append(given[0])
	var guard: String = _local_guard(node, target, where, member)
	if guard == LOCAL_REFUSED:
		return []
	_use_helper(Library.TWEEN_HELPER)
	var easing: String = Library.TWEEN_EASINGS.get(str(node.settings.get(&"easing", "Quad")), "Tween.TRANS_QUAD")
	var direction: String = Library.TWEEN_DIRECTIONS.get(str(node.settings.get(&"direction", "Out")), "Tween.EASE_OUT")
	var call: String = "_brickscript_tween(%s, &%s, %s, %s, %s, %s, %s, %s, %s, %s)" % [target[0], var_to_str(name), value, codes[0], easing, direction, codes[1], codes[2], everywhere, _brick_label(node)]
	if str(node.settings.get(&"then", "")) == Library.ANIMATION_THEN[1]:
		call = "await _brickscript_tween_end(%s)" % call
	return _guarded(guard, call)


## Unpack table: each key into the variable of its name (a new chain
## variable of the Table's value type, or an existing one), its type's zero
## when the key is missing.
func _unpack_table(node: BrickscriptFlowNode, definition: Dictionary, where: String) -> PackedStringArray:
	var table: Array = _input(node, definition["inputs"][0], where)
	if table.is_empty():
		return []
	var keys: Dictionary = NodeTypes.table_keys(table[2])
	if not NodeTypes.list_item(keys) in [T.ANY, T.TEXT]:
		errors.append("%s > table: its keys are %s; Unpack table reads Text keys (names)" % [where, NodeTypes.describe_table(table[2])])
		return []
	var values: Dictionary = NodeTypes.table_values(table[2])
	var value_type: int = NodeTypes.list_item(values)
	var missing: String = "null" if value_type in [T.ANY, T.NODE, T.RESOURCE] else _default_code(value_type)
	var lines: PackedStringArray = []
	for row: int in range(1, Ops.row_count(node) + 1):
		var input: StringName = StringName("key_%d" % row)
		var data: Dictionary = node.inputs.get(input, definition["variadic"]["inputs"][0]["default"])
		if data.has("var"):
			errors.append("%s > %s: a key is typed in (it names the variable it fills)" % [where, input])
			return []
		var key: String = str(data.get("value", "")).strip_edges()
		if not _exists(key):
			if not _check_name(key, "%s > %s" % [where, input]):
				return []
			_new_chain_variable(key, value_type, values.get("items", {}))
		var assigned: PackedStringArray = _assign(key, "%s.get(%s, %s)" % [table[0], var_to_str(key), missing], value_type, where, values.get("items", {}))
		if assigned.is_empty():
			return []
		lines.append_array(assigned)
	return lines


## While: a counted loop up to its Safety limit, which first checks the
## comparison each round (so Continue checks it again too); reaching the
## limit is an error naming the brick.
func _while_start(node: BrickscriptFlowNode, definition: Dictionary, where: String) -> PackedStringArray:
	var condition: String = _if_condition(node, definition, where)
	if condition.is_empty():
		return []
	var limit: Array = _input(node, definition["inputs"][2], where)
	if limit.is_empty():
		return []
	var rounds: String = "roundi(%s)" % limit[0] if limit[1] == T.NUMBER else limit[0]
	var counter: String = "_w_%d" % node.id
	var stopped: String = var_to_str("While (brick %d): stopped at its Safety limit (%%d rounds); does its comparison ever change?" % node.id)
	return PackedStringArray(["for %s: int in range(%s + 1):" % [counter, rounds], "if not (%s):" % condition, "\tbreak",
		"if %s == %s:" % [counter, rounds], "\tpush_error(%s %% %s)" % [stopped, rounds], "\tbreak"])


func _set_var(node: BrickscriptFlowNode, definition: Dictionary, where: String) -> PackedStringArray:
	if _declaring.has(node.id):
		# A Constant / Export declaration: set before the game starts.
		return []
	var name: String = str(node.settings.get(&"name", "")).strip_edges()
	if name.is_empty():
		errors.append("%s: needs a variable name" % where)
		return []
	if Library.mode_of(node) == "Get":
		if not _exists(name):
			errors.append("%s: no variable named '%s' here%s" % [where, name, _did_you_mean(name)])
			_make_anyway(node.output_name.strip_edges(), false)
			return []
		var held: Array = _read(name, where)
		return _output(node, held[0], held[1], where, held[2]) if not held.is_empty() else []
	if not _server and _synced.has(name):
		errors.append(SYNCED_BY_SERVER % [where, name])
		return []
	var value: Array = _input(node, definition["inputs"][0], where)
	if _adding(node):
		return [] if value.is_empty() else _add_to_var(name, value, where)
	var shared: bool = set_var_kind(node) in ["Shared", Library.SET_VAR_KIND_SYNCED]
	if value.is_empty():
		_make_anyway(name, shared)
		return []
	if not _exists(name):
		if not _check_name(name, where):
			return []
		if shared:
			_implicit[name] = value[1]
			if value[1] in [T.NODE, T.LIST, T.TABLE, T.RESOURCE]:
				_implicit_nodes[name] = value[2]
		else:
			_new_chain_variable(name, value[1], value[2])
	return _assign(name, value[0], value[1], where, value[2])


## Set Var's Add: `name = name + value` for an existing number or vector
## variable (a Whole one rounds what a Number adds).
func _add_to_var(name: String, value: Array, where: String) -> PackedStringArray:
	if not _exists(name):
		errors.append("%s: Add needs a variable that already exists ('%s' isn't one here; Mode Set makes it)" % [where, name])
		return []
	var held: Array = _read(name, where)
	if held.is_empty():
		return []
	if not held[1] in Library.ADDABLE_TYPES:
		errors.append("%s: '%s' holds a %s; only numbers and vectors can be added to (Mode: Set)" % [where, name, Types.type_name(held[1])])
		return []
	if Types.VECTORS.has(held[1]) and Types.NUMERIC.has(value[1]):
		errors.append("%s > value: '%s' holds a %s; add a %s to it" % [where, name, Types.type_name(held[1]), Types.type_name(held[1])])
		return []
	if Types.NUMERIC.has(held[1]) and Types.VECTORS.has(value[1]):
		errors.append("%s > value: '%s' holds a %s; add a number to it" % [where, name, Types.type_name(held[1])])
		return []
	var type: int = value[1] if held[1] == T.ANY or held[1] == T.WHOLE and value[1] == T.NUMBER else held[1]
	return _assign(name, "%s + %s" % [held[0], value[0]], type, where)


## Where a node's result goes (see the class description).
func _output(node: BrickscriptFlowNode, code: String, type: int, where: String, node_type: Dictionary = {}) -> PackedStringArray:
	var name: String = node.output_name.strip_edges()
	if name.is_empty():
		warnings.append("%s: result not kept (no Output Var name)" % where)
		return []
	if node.use_var:
		if not _exists(name):
			errors.append("%s > Use Var: no variable named '%s'%s" % [where, name, _did_you_mean(name)])
			return []
	elif _script.has(name) or _implicit.has(name):
		errors.append("%s > Output Var: '%s' is a script variable; tick Use Var to write into it" % [where, name])
		return []
	elif not _exists(name):
		if not _check_name(name, where + " > Output Var"):
			return []
		_new_chain_variable(name, type, node_type)
	return _assign(name, code, type, where, node_type)


## An event's values that arrive as a player's number (the engine's signals,
## messages) but are Players in the brickscript: made their nodes first.
func _player_params(definition: Dictionary) -> Array[String]:
	var found: Array[String] = []
	var provides: Dictionary = definition.get("provides", {})
	for param: Array in definition.get("function_params", []):
		if param[1] == "int" and int(provides.get(param[0], -1)) == T.PLAYER:
			found.append(param[0])
	return found


## The code of a Player value for the engine's helpers: the player's number.
func _peer_code(given: Array) -> String:
	if given[1] != T.PLAYER:
		return given[0]
	_use_helper(Library.PLAYER_NODE_HELPER)
	return "_brickscript_peer(%s)" % given[0]


## `name = code`, if `name` exists, may be written, and can hold `type`.
func _assign(name: String, code: String, type: int, where: String, node_type: Dictionary = {}) -> PackedStringArray:
	var target: Dictionary = {}
	var gd: String = name
	if _chain.has(name):
		target = {"type": _chain[name]["type"], "writable": true}
		gd = _chain[name]["gd"]
	elif _provided.has(name):
		target = {"type": _provided[name], "writable": false}
	elif _script.has(name):
		target = _script[name]
	else:
		target = {"type": _implicit[name], "writable": true}
	if not target["writable"]:
		var kind: String = "an event value" if _provided.has(name) else ["a Constant", "an Export"][target["kind"]]
		var fix: String = " (make a changeable Shared copy)" if not _provided.has(name) and target["kind"] == Kind.EXPORT else ""
		errors.append("%s: '%s' is %s and can't be changed%s" % [where, name, kind, fix])
		return []
	var wanted: int = target["type"]
	if not Types.fits(type, wanted):
		errors.append("%s: '%s' holds a %s, not a %s" % [where, name, Types.type_name(wanted), Types.type_name(type)])
		return []
	var wanted_node: Dictionary = _node_of(name)
	if type == T.NODE and wanted == T.NODE and not NodeTypes.fits(node_type, wanted_node):
		errors.append("%s: '%s' holds a %s, not a %s" % [where, name, NodeTypes.describe(wanted_node), NodeTypes.describe(node_type)])
		return []
	if type == T.RESOURCE and wanted == T.RESOURCE and not _resource_fits(node_type, wanted_node.get("class", &"")):
		errors.append("%s: '%s' holds a %s, not a %s" % [where, name, wanted_node.get("class", "Resource"), node_type.get("class", "Resource")])
		return []
	if wanted == T.LIST:
		# A typed List takes only its items: others are converted into a new
		# Array of them (checked when the game runs), or refused.
		var given_list: Dictionary = node_type if type == T.LIST else {}
		var how: String = NodeTypes.list_fit(given_list, wanted_node)
		if how == "no":
			errors.append("%s: '%s' is a %s, not a %s" % [where, name, NodeTypes.describe_list(wanted_node), NodeTypes.describe_list(given_list)])
			return []
		code = NodeTypes.list_converted(code, wanted_node, how)
	if wanted == T.TABLE:
		# A typed Table likewise (no rounding: Number into Whole is refused).
		var given_table: Dictionary = node_type if type == T.TABLE else {}
		var how: String = NodeTypes.table_fit(given_table, wanted_node)
		if how == "no":
			errors.append("%s: '%s' is a %s, not a %s" % [where, name, NodeTypes.describe_table(wanted_node), NodeTypes.describe_table(given_table)])
			return []
		code = NodeTypes.table_converted(code, wanted_node, how)
	if wanted == T.WHOLE and type == T.NUMBER:
		code = "roundi(%s)" % code
	return ["%s = %s" % [gd, code]]


## A node with a problem still makes the variable it names (type Anything),
## so later bricks see it in their dropdowns and don't each report "no
## variable named" on top of the real problem.
func _make_anyway(name: String, shared: bool) -> void:
	if name.is_empty() or _exists(name) or not name.is_valid_ascii_identifier() or RESERVED_NAMES.has(name):
		return
	if shared:
		_implicit[name] = T.ANY
	else:
		_new_chain_variable(name, T.ANY)


func _new_chain_variable(name: String, type: int, node_type: Dictionary = {}) -> void:
	var gd: String = name
	# Two events in one function would otherwise both declare it.
	if _function["names"].has(gd):
		gd = "%s_%d" % [name, _event_number]
	_function["names"][gd] = true
	_chain[name] = {"type": type, "gd": gd, "node": node_type if type in [T.NODE, T.LIST, T.TABLE, T.RESOURCE] else {}}


## The node type of the Node variable `name` ({} if unknown / not a Node).
func _node_of(name: String) -> Dictionary:
	if _chain.has(name):
		return _chain[name].get("node", {})
	if _script.has(name):
		return _script[name].get("node", {})
	return _implicit_nodes.get(name, {})


## A variable's GDScript type: Node variables are typed by their node class,
## Lists by their items (`Array[float]`), Tables by their keys and values
## (`Dictionary[String, float]`).
func _gd_type(type: int, node_type: Dictionary) -> String:
	if type == T.LIST:
		return NodeTypes.list_gd_type(node_type)
	if type == T.TABLE:
		return NodeTypes.table_gd_type(node_type)
	if type == T.RESOURCE and NodeTypes.is_resource_class(node_type.get("class", &"")):
		return String(node_type["class"])
	return NodeTypes.gd_class(node_type) if type == T.NODE and not node_type.is_empty() else Types.gd_type(type)


func _record_scope(id: int) -> void:
	var scope: Dictionary = scopes.get_or_add(id, {})
	for name: String in _script:
		scope[name] = {"type": _script[name]["type"], "writable": _script[name]["writable"], "origin": _origin(name), "node": _script[name].get("node", {})}
	for name: String in _implicit:
		scope[name] = {"type": _implicit[name], "writable": true, "origin": _origin(name), "node": _implicit_nodes.get(name, {})}
	for name: Variant in _provided:
		scope[str(name)] = {"type": _provided[name], "writable": false, "origin": "event", "node": _provided_nodes.get(name, {})}
	for name: String in _chain:
		scope[name] = {"type": _chain[name]["type"], "writable": true, "origin": "chain", "node": _chain[name].get("node", {})}


## Where a script variable comes from: Constant, Export, Shared or Synced.
func _origin(name: String) -> String:
	if _synced.has(name):
		return Library.SET_VAR_KIND_SYNCED
	return ["Constant", "Export", "Shared"][_script[name]["kind"]] if _script.has(name) else "Shared"


func _use_helper(helper: String) -> void:
	if not _helpers.has(helper):
		_helpers.append(helper)


func _exists(name: String) -> bool:
	return _chain.has(name) or _provided.has(name) or _script.has(name) or _implicit.has(name)


## [code, type, node type] for reading the variable `name`, or [] (error
## recorded).
func _read(name: String, where: String) -> Array:
	if _chain.has(name):
		return [_chain[name]["gd"], _chain[name]["type"], _node_of(name)]
	if _provided.has(name):
		_function["used"][name] = true
		return [name, _provided[name], _provided_nodes.get(name, {})]
	if _script.has(name):
		return [name, _script[name]["type"], _node_of(name)]
	if _implicit.has(name):
		return [name, _implicit[name], _node_of(name)]
	if ClassDB.class_exists(name) or Engine.has_singleton(name):
		errors.append("%s: '%s' is one of Godot's classes, which bricks and Formulas don't reach: only values, variables and Formula's math functions (API.md, Formula); use a brick for it (Property, Call method...)" % [where, name])
	else:
		var near: String = _did_you_mean(name)
		errors.append("%s: no variable named '%s' here%s" % [where, name, near if not near.is_empty() else " (a node that runs earlier must make it)"])
	return []


## ": did you mean 'score'?" for a misspelled variable name: one known here
## within two letters' changes (a swap counts as one), else "" (BUGS.md
## 2026-10-31: a typo sent a beginner off to add a brick).
func _did_you_mean(name: String) -> String:
	var best: String = ""
	var best_distance: int = 3
	for known: Variant in _chain.keys() + _provided.keys() + _script.keys() + _implicit.keys():
		var distance: int = _typo_distance(name.to_lower(), str(known).to_lower())
		if distance < best_distance and str(known) != name:
			best = str(known)
			best_distance = distance
	return ": did you mean '%s'?" % best if not best.is_empty() and best_distance <= mini(2, name.length() / 2) else ""


## Edits from `a` to `b`: letters added, removed, changed, or two swapped.
static func _typo_distance(a: String, b: String) -> int:
	if absi(a.length() - b.length()) > 2:
		return 99
	var rows: Array[PackedInt32Array] = []
	for i: int in a.length() + 1:
		var row: PackedInt32Array = PackedInt32Array()
		row.resize(b.length() + 1)
		row[0] = i
		rows.append(row)
	for j: int in b.length() + 1:
		rows[0][j] = j
	for i: int in range(1, a.length() + 1):
		for j: int in range(1, b.length() + 1):
			var cost: int = 0 if a[i - 1] == b[j - 1] else 1
			var best: int = mini(mini(rows[i - 1][j] + 1, rows[i][j - 1] + 1), rows[i - 1][j - 1] + cost)
			if i > 1 and j > 1 and a[i - 1] == b[j - 2] and a[i - 2] == b[j - 1]:
				best = mini(best, rows[i - 2][j - 2] + 1)
			rows[i][j] = best
	return rows[a.length()][b.length()]


## [code, type, node type] for one input, or [] (error recorded). A typed-in
## Node path "." is this node.
func _input(node: BrickscriptFlowNode, spec: Dictionary, where: String) -> Array:
	where += " > " + String(spec["name"])
	var data: Dictionary = node.inputs.get(spec["name"], spec["default"])
	var allowed: Array = spec["types"]
	var result: Array = []
	if data.has("var"):
		var name: String = str(data["var"]).strip_edges()
		if name.is_empty():
			# (Player Direction's blank player: this node's Owner.)
			if spec.has("blank"):
				return [str(spec["blank"]) % _self_code, allowed[0] if allowed.size() == 1 else T.ANY, {}]
			var wanted: String = " or ".join(allowed.map(func(type: int) -> String: return Types.type_name(type)))
			errors.append("%s: no variable name (pick a variable holding a %s%s)" % [where, wanted,
				", e.g. sender, or Player Joined's player" if allowed.has(T.PLAYER) else ""])
			return []
		result = _read(name, where)
		if result.is_empty():
			return []
		if spec.get("writes", false) and not _can_change(name, where):
			return []
	else:
		var type: int = int(data.get("type", T.ANY))
		if type == T.NODE and spec.has("blank") and str(data.get("value", "")).strip_edges().is_empty():
			# (A Terrain input left blank: the scene's Terrain, found when it
			# runs.)
			return [str(spec["blank"]), T.NODE, terrain_type() if spec.has("node_script") else {}]
		var problem: String = Types.literal_problem(type, data.get("value", null))
		if not problem.is_empty():
			errors.append("%s: %s" % [where, problem])
			return []
		result = [Types.literal(type, data["value"]), type, {}]
		if type == T.NODE:
			# "." and ".." know their types; another path keeps the node type
			# its picker found in the scenes (stored with it, so the game's
			# compile, which reads no scenes, gives the same code).
			result[2] = {".": _self_type, "..": _parent_type}.get(str(data["value"]).strip_edges(), data.get("node", {}))
			if _script_node:
				result = _script_node_path(str(data["value"]), data.get("node", {}))
		if type == T.LIST:
			# An empty List typed in with an item type ("of" dropdown).
			result[2] = NodeTypes.list_info_of_value(data["value"])
		if type == T.TABLE:
			# An empty Table typed in with its key and value types.
			result[2] = NodeTypes.table_info_of_value(data["value"])
		if type == T.RESOURCE:
			# A picked file: its class from its extension, and the file itself.
			var file: String = str(data["value"]).strip_edges()
			result[2] = {"class": NodeTypes.resource_class_of(file), "path": file}
			if not ResourceLoader.exists(file):
				warnings.append("%s: %s doesn't exist (yet)" % [where, file])
			var wanted_class: StringName = spec.get("resource_class", &"")
			if not NodeTypes.resource_fits(file, wanted_class):
				errors.append("%s: %s isn't a %s" % [where, file.get_file(), wanted_class])
				return []
		if type == T.NODE and _body and not _script_node:
			# Paths start from the node it acts for.
			result[0] = _self_code if result[0] == "self" else "%s.%s" % [_self_code, result[0]]
	if result[1] == T.TEXT and allowed.has(T.RESOURCE):
		# A path as Text (e.g. built by a Formula): loaded when the brick runs.
		result = _loaded(result)
	if result[1] == T.PLAYER and allowed.has(T.NODE) and not allowed.has(T.PLAYER):
		# A player is a node (its values are its children).
		result = [result[0], T.NODE, {"class": &"Node", "script": PLAYER_SCRIPT}]
	if not allowed.is_empty() and not allowed.any(func(wanted: int) -> bool: return Types.fits(result[1], wanted)):
		var names: PackedStringArray = []
		for wanted: int in allowed:
			names.append(Types.type_name(wanted))
		errors.append("%s: got a %s, needs %s" % [where, Types.type_name(result[1]), " or ".join(names)])
		return []
	return result


## Whether a node may change the variable `name` in place (Add to list, ...);
## records an error if not.
func _can_change(name: String, where: String) -> bool:
	if not _server and _synced.has(name):
		errors.append(SYNCED_BY_SERVER % [where, name])
		return false
	if _chain.has(name) or _implicit.has(name):
		return true
	if _provided.has(name):
		errors.append("%s: '%s' is an event value and can't be changed" % [where, name])
		return false
	if not _script[name]["writable"]:
		var export: bool = _script[name]["kind"] == Kind.EXPORT
		errors.append("%s: '%s' is %s and can't be changed%s" % [where, name, "an Export" if export else "a Constant", " (make a changeable Shared copy)" if export else ""])
		return false
	return true


## [code, type] for a Formula, or [] (error recorded). Every name in it must
## be a variable or one of FORMULA_NAMES; the result type is found by trying
## the formula once with sample values (Anything if it reads a variable that
## has no sample: List, Table, Node, Anything).
func _formula(node: BrickscriptFlowNode, where: String) -> Array:
	var text: String = str(node.settings.get(&"expression", "")).strip_edges()
	if text.is_empty():
		errors.append("%s: the formula is empty" % where)
		return []
	if text.contains("\n"):
		errors.append("%s: the formula must be one line" % where)
		return []
	var code: String = ""
	var names: PackedStringArray = []
	var samples: Array = []
	var untried: String = ""
	var i: int = 0
	while i < text.length():
		var rest: String = text.substr(i)
		var c: String = text[i]
		if c == "\"" or c == "'":
			var end: int = i + 1
			while end < text.length() and text[end] != c:
				end += 2 if text[end] == "\\" else 1
			code += text.substr(i, end + 1 - i)
			i = end + 1
			continue
		var number: RegExMatch = _number.search(rest)
		if number != null:
			code += number.get_string()
			i += number.get_string().length()
			continue
		var found: RegExMatch = _identifier.search(rest)
		if found == null:
			code += c
			i += 1
			continue
		var name: String = found.get_string()
		i += name.length()
		if code.strip_edges(false, true).ends_with(".") or FORMULA_NAMES.has(name):
			code += name
			continue
		var variable: Array = _read(name, where + " > formula")
		if variable.is_empty():
			return []
		if variable[1] == T.PLAYER and code.ends_with("str(") and text.substr(i).strip_edges(true, false).begins_with(")"):
			# str(player): their name, or "no player" (not "<null>").
			_use_helper(Library.PLAYER_TEXT_HELPER)
			code = code.trim_suffix("str(") + "_brickscript_player_text("
		code += variable[0]
		if not names.has(name):
			names.append(name)
			samples.append(Types.sample_value(variable[1]))
			if samples.back() == null:
				untried = Types.type_name(variable[1])
	var expression: Expression = Expression.new()
	if expression.parse(text, names) != OK:
		# A variable named like a built-in function (seed, sign, hash...)
		# reads as a call in a formula (2026-11-02, a blind run's `seed`).
		for name: String in names:
			if Expression.new().parse(name, PackedStringArray([name])) != OK:
				errors.append("%s: formula: '%s' is the name of a built-in function (%s()), so a formula can't read a variable called that: rename the variable (e.g. 'my_%s')" % [where, name, name, name])
				return []
		errors.append("%s: formula: %s" % [where, expression.get_error_text()])
		return []
	if not untried.is_empty():
		# It reads a List, Table, Node or Anything: it can't be tried with
		# sample values, so its result is Anything (checked when it runs).
		return [code, T.ANY]
	var result: Variant = expression.execute(samples, null, false)
	if expression.has_execute_failed():
		var problem: String = expression.get_error_text()
		# ("Text" + player: GDScript's words for it are "String and Object".)
		if problem.contains("String and Object") or problem.contains("Object and String"):
			problem += " A Player or a node isn't Text: use str(...) on it (str(player) is their name)."
		errors.append("%s: formula: %s" % [where, problem])
		return []
	var type: int = Types.of_value(result)
	if not Types.is_known(type) or type == T.NODE:
		errors.append("%s: formula: can't tell what it gives" % where)
		return []
	return [code, type]

#endregion


#region Node bricks

## The Layers setting as a collision mask: "1, 3" -> layers 1 and 3; blank:
## all. -1 on error (recorded).
func _layer_mask(node: BrickscriptFlowNode, where: String) -> int:
	var text: String = str(node.settings.get(&"layers", "")).strip_edges()
	if text.is_empty():
		return Library.ALL_LAYERS
	var mask: int = 0
	for part: String in text.replace(" ", ",").split(",", false):
		if not part.is_valid_int() or int(part) < 1 or int(part) > 32:
			errors.append("%s > Layers: '%s' isn't a layer number (1 to 32)" % [where, part])
			return -1
		mask |= 1 << (int(part) - 1)
	return mask


## Bodies near (a List of what it finds) and Raycast (the first node hit).
func _physics_query(node: BrickscriptFlowNode, definition: Dictionary, where: String) -> PackedStringArray:
	var args: PackedStringArray = []
	var kinds: Array[int] = []
	for spec: Dictionary in definition["inputs"]:
		if spec["name"] == &"relative_to":
			continue
		var given: Array = _input(node, spec, where)
		if given.is_empty():
			return []
		args.append(given[0])
		kinds.append(given[1])
	if node.type == &"raycast" and Ops.input_shown(node, &"relative_to"):
		# From / To in the node's own space: into world positions.
		var relative: Array = _input(node, Ops.input_spec(node.type, &"relative_to"), where)
		if relative.is_empty():
			return []
		var space_class: String = "Node2D" if kinds[0] == T.VECTOR2 or kinds[1] == T.VECTOR2 else "Node3D"
		var known: StringName = relative[2].get("class", &"Node")
		if known != &"Node" and not ClassDB.is_parent_class(known, StringName(space_class)):
			errors.append("%s > relative_to: a %s has no position of its own; points relative to a node need a %s" % [where, NodeTypes.describe(relative[2]), space_class])
			return []
		for i: int in 2:
			args[i] = ("%s.to_global(%s)" if known != &"Node" else "%s.call(&\"to_global\", %s)") % [relative[0], args[i]]
	var look_for: int = maxi(Library.LOOK_FOR.find(str(node.settings.get(&"look_for", Library.LOOK_FOR[0]))), 0)
	var mask: int = _layer_mask(node, where)
	if mask < 0:
		return []
	var node_type: Dictionary = _node_type_setting(node, where)
	var gd_class: String = NodeTypes.gd_class(node_type)
	if node.type == &"raycast":
		if kinds[0] != kinds[1] and not T.ANY in kinds:
			errors.append("%s: From and To must both be Vector2s (2D) or both Vector3s (3D)" % where)
			return []
		_use_helper(Library.RAYCAST_HELPER)
		var wanted: String = var_to_str(StringName(gd_class)) if gd_class != "Node" else "&\"\""
		var hit: String = "_brickscript_raycast(%s, %s, %d, %s, %d, %s)" % [args[0], args[1], look_for, _self_code, mask, wanted]
		var vector: int = kinds[0] if kinds[0] != T.ANY else kinds[1]
		var zero: String = "Vector2.ZERO" if vector == T.VECTOR2 else "Vector3.ZERO"
		# Hit point / Normal / Distance, from the hit the helper keeps.
		var names: Array = [
			[&"point_name", "_brickscript_ray_hit.get(\"position\", %s)" % args[1], vector],
			[&"normal_name", "_brickscript_ray_hit.get(\"normal\", %s)" % zero, vector],
			[&"distance_name", "(%s).distance_to(_brickscript_ray_hit[\"position\"]) if not _brickscript_ray_hit.is_empty() else -1.0" % args[0], T.NUMBER],
		].filter(func(entry: Array) -> bool: return not str(node.settings.get(entry[0], "")).strip_edges().is_empty())
		var lines: PackedStringArray = []
		# Its exits (Hit / Nothing hit) need the cast too, kept or not.
		if node.output_name.strip_edges().is_empty() and (not names.is_empty() or not node.exits.is_empty()):
			lines.append(hit)
		else:
			if gd_class != "Node":
				hit += " as " + gd_class
			lines = _output(node, hit, T.NODE, where, node_type)
			if lines.is_empty():
				return []
		for entry: Array in names:
			var name: String = str(node.settings.get(entry[0], "")).strip_edges()
			if not _exists(name):
				if not _check_name(name, where + " > " + String(entry[0]).trim_suffix("_name")):
					return []
				_new_chain_variable(name, entry[2])
			var assigned: PackedStringArray = _assign(name, entry[1], entry[2], where)
			if assigned.is_empty():
				return []
			lines.append_array(assigned)
		return lines
	_use_helper(Library.BODIES_NEAR_HELPER)
	var code: String = "_brickscript_bodies_near(%s, %s, %d, %s, %d)" % [args[0], args[1], look_for, _self_code, mask]
	var list: Dictionary = NodeTypes.list_info(T.NODE, node_type)
	if gd_class != "Node":
		code = NodeTypes.list_converted(code + ".filter(func(found: Node) -> bool: return found is %s)" % gd_class, list, "convert")
	return _output(node, code, T.LIST, where, list)

## Nearest character: a Character3D (or null), and its Distance when named.
func _nearest_character(node: BrickscriptFlowNode, definition: Dictionary, where: String) -> PackedStringArray:
	var args: PackedStringArray = []
	for spec: Dictionary in definition["inputs"]:
		var given: Array = _input(node, spec, where)
		if given.is_empty():
			return []
		args.append(given[0])
	_use_helper(Library.NEAREST_HELPER)
	_use_helper(Library.PLACE_HELPER)
	var players_only: bool = str(node.settings.get(&"among", Library.NEAREST_AMONG[0])) == Library.NEAREST_AMONG[0]
	var code: String = "_brickscript_nearest(%s, %s, %s, %s)" % [args[0], "true" if players_only else "false", args[1], _brick_label(node)]
	return _with_also(node, code, T.NODE, &"distance_name", "_brickscript_nearest_distance", where, {"class": &"AnimatableBody3D", "script": Library.CHARACTER_SCRIPTS[0]})


## Its Output (`code`, of `type`), and the chain variable named by setting
## `name_setting` (Also fills) set to `also` (a Number), either alone.
func _with_also(node: BrickscriptFlowNode, code: String, type: int, name_setting: StringName, also: String, where: String, node_type: Dictionary = {}) -> PackedStringArray:
	var also_name: String = str(node.settings.get(name_setting, "")).strip_edges()
	var lines: PackedStringArray = []
	if node.output_name.strip_edges().is_empty() and not also_name.is_empty():
		lines.append(code)
	else:
		lines = _output(node, code, type, where, node_type)
		if lines.is_empty():
			return []
	if not also_name.is_empty():
		if not _exists(also_name):
			if not _check_name(also_name, where + " > " + String(name_setting).trim_suffix("_name")):
				return []
			_new_chain_variable(also_name, T.NUMBER)
		var assigned: PackedStringArray = _assign(also_name, also, T.NUMBER, where)
		if assigned.is_empty():
			return []
		lines.append_array(assigned)
	return lines


## Terrain ray: the point where the line meets the ground (To when it
## doesn't) as its Output, Normal when named, Hit ground / No ground exits.
func _terrain_ray(node: BrickscriptFlowNode, definition: Dictionary, where: String) -> PackedStringArray:
	var args: Array[Array] = []
	for spec: Dictionary in definition["inputs"]:
		var given: Array = _input(node, spec, where)
		if given.is_empty():
			return []
		if spec.get("node_script", "") == Library.TERRAIN_SCRIPT and not _could_be_terrain(given[2]):
			errors.append("%s > terrain: needs a Terrain (the Terrain Engine plugin's node), not a %s" % [where, NodeTypes.describe(given[2])])
			return []
		args.append(given)
	_use_helper(Library.TERRAIN_HELPER)
	_use_helper(Library.TERRAIN_CHANGE_HELPER)
	_use_helper(Library.PLACE_HELPER)
	_use_helper(Library.TERRAIN_MORE_HELPER)
	var lines: PackedStringArray = ["_brickscript_terrain_hit = _brickscript_terrain_ray(%s, %s, %s, %s)" % [args[0][0], args[1][0], args[2][0], _brick_label(node)]]
	if not node.output_name.strip_edges().is_empty():
		var kept: PackedStringArray = _output(node, "_brickscript_terrain_hit[\"position\"]", T.VECTOR3, where)
		if kept.is_empty():
			return []
		lines.append_array(kept)
	var normal: String = str(node.settings.get(&"normal_name", "")).strip_edges()
	if not normal.is_empty():
		if not _exists(normal):
			if not _check_name(normal, where + " > normal"):
				return []
			_new_chain_variable(normal, T.VECTOR3)
		var assigned: PackedStringArray = _assign(normal, "_brickscript_terrain_hit[\"normal\"]", T.VECTOR3, where)
		if assigned.is_empty():
			return []
		lines.append_array(assigned)
	return lines


## Random open spot (2026-11-02): the spot (Around when none) as its
## Output, Found / None found exits; the settings as true / false.
func _open_spot(node: BrickscriptFlowNode, definition: Dictionary, where: String) -> PackedStringArray:
	var args: PackedStringArray = []
	for spec: Dictionary in definition["inputs"]:
		var given: Array = _input(node, spec, where)
		if given.is_empty():
			return []
		if spec.get("node_script", "") == Library.TERRAIN_SCRIPT and not _could_be_terrain(given[2]):
			errors.append("%s > terrain: needs a Terrain (the Terrain Engine plugin's node), not a %s" % [where, NodeTypes.describe(given[2])])
			return []
		args.append(given[0])
	var flags: PackedStringArray = []
	for setting: Dictionary in definition["settings"]:
		var picked: String = str(node.settings.get(setting["name"], setting["default"]))
		flags.append(str((setting["codes"] as Dictionary).get(picked, (setting["codes"] as Dictionary)[setting["default"]])))
	_use_helper(Library.TERRAIN_HELPER)
	_use_helper(Library.TERRAIN_CHANGE_HELPER)
	_use_helper(Library.PLACE_HELPER)
	_use_helper(Library.TERRAIN_MORE_HELPER)
	_use_helper(Library.OPEN_SPOT_HELPER)
	var lines: PackedStringArray = ["_brickscript_open_spot = _brickscript_random_open_spot(%s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s)" % [args[0], args[1], args[2], args[3], args[4], args[5], args[6],
		flags[0], flags[1], flags[2], _brick_label(node)]]
	if not node.output_name.strip_edges().is_empty():
		var kept: PackedStringArray = _output(node, "_brickscript_open_spot[\"position\"]", T.VECTOR3, where)
		if kept.is_empty():
			return []
		lines.append_array(kept)
	return lines


## Find path: a List of Vector3s (the path), and its Length when named.
func _find_path(node: BrickscriptFlowNode, definition: Dictionary, where: String) -> PackedStringArray:
	var args: PackedStringArray = []
	for spec: Dictionary in definition["inputs"]:
		var given: Array = _input(node, spec, where)
		if given.is_empty():
			return []
		args.append(given[0])
	_use_helper(Library.FIND_PATH_HELPER)
	var code: String = "_brickscript_find_path(%s, %s, %s)" % [args[0], args[1], _brick_label(node)]
	return _with_also(node, code, T.LIST, &"length_name", "_brickscript_path_length", where, NodeTypes.list_info(T.VECTOR3))


## Whether a node of this type is a `wanted` (or might be: a plain Node or an
## unknown type).
func _is_class(node_type: Dictionary, wanted: StringName) -> bool:
	var known: StringName = node_type.get("class", &"Node")
	return known == &"Node" or not NodeTypes.is_node_class(known) or known == wanted or ClassDB.is_parent_class(known, wanted)


## Mesh vertices: Get reads a mesh's points (or their colors) into a typed
## List; Set puts a List of them back (a local brickscript: only on what it
## may change).
func _mesh_vertices(node: BrickscriptFlowNode, codes: Dictionary[String, String], types: Dictionary[String, int], infos: Dictionary[String, Dictionary], where: String) -> PackedStringArray:
	var as_colors: bool = str(node.settings.get(&"of", Library.MESH_POINTS_OF[0])) == "Colors"
	var item: int = T.COLOR if as_colors else T.VECTOR3
	_use_helper(Library.MESH_HELPER)
	var brick: String = _brick_label(node)
	if str(node.settings.get(&"mode", Library.MESH_MODES[0])) == "Get":
		var read: String = "_brickscript_mesh_%s(%s, %s)" % ["colors" if as_colors else "points", codes["mesh"], brick]
		return _output(node, read, T.LIST, where, NodeTypes.list_info(item))
	var given: int = NodeTypes.list_item(infos["value"])
	if given != T.ANY and given != item:
		errors.append("%s > value: needs a List of %ss, not a %s" % [where, Types.type_name(item), NodeTypes.describe_list(infos["value"])])
		return []
	var guard: String = _local_guard(node, [codes["mesh"], types["mesh"], infos["mesh"]], where)
	if guard == LOCAL_REFUSED:
		return []
	return _guarded(guard, "_brickscript_mesh_set(%s, %s, %s, %s, %s)" % [codes["mesh"], codes["value"], as_colors, _server, brick])


## Mouse to World / Player Aim (a point in the world: the far end of a ray in
## 3D, with its start for From) and World to Screen (a screen point, with On
## screen).
func _camera_brick(node: BrickscriptFlowNode, definition: Dictionary, where: String) -> PackedStringArray:
	var args: Dictionary[String, Array] = {}
	for spec: Dictionary in Ops.input_specs(node):
		if not Ops.input_shown(node, spec["name"]):
			args[String(spec["name"])] = [str(spec.get("unused", "null")), T.ANY, {}]
			continue
		var given: Array = _input(node, spec, where)
		if given.is_empty():
			return []
		args[String(spec["name"])] = given
	var three_d: bool = str(node.settings.get(&"space", Library.CAMERA_SPACES[0])) != "2D"
	if node.type == &"screen_to_world" and str(node.settings.get(&"point_is", "")) == Library.SCREEN_MIDDLE:
		args["point"] = ["get_viewport().get_visible_rect().get_center()", T.VECTOR2, {}]
	if node.type == &"world_to_screen":
		three_d = args["position"][1] != T.VECTOR2
	if args.has("camera") and Ops.input_shown(node, &"camera"):
		var wanted: StringName = &"Camera3D" if three_d else &"Camera2D"
		var known: StringName = args["camera"][2].get("class", &"Node")
		if known != &"Node" and not ClassDB.is_parent_class(known, wanted):
			errors.append("%s > camera: a %s isn't a %s" % [where, NodeTypes.describe(args["camera"][2]), wanted])
			return []
	var brick: String = _brick_label(node)
	var code: String = ""
	var type: int = T.VECTOR3 if three_d else T.VECTOR2
	var extra: Array = []
	_use_helper(Library.CAMERA_HELPER)
	match node.type:
		&"screen_to_world":
			_use_helper(Library.SCREEN_TO_WORLD_HELPER)
			code = "_brickscript_screen_to_world(%s, %s, %s, %s, %s)" % [args["camera"][0], args["point"][0], three_d, args["length"][0], brick]
			extra = [&"from_name", "_brickscript_ray_from", type]
		&"player_aim":
			_use_helper(Library.SCREEN_TO_WORLD_HELPER)
			_use_helper(Library.PLAYER_AIM_HELPER)
			var middle: bool = str(node.settings.get(&"through", "The mouse")) == Library.SCREEN_MIDDLE
			code = "_brickscript_player_aim(%s, %s, %s, %s%s)" % [_peer_code(args["player"]), three_d, args["length"][0], brick, ", true" if middle else ""]
			extra = [&"from_name", "_brickscript_ray_from", type]
		&"world_to_screen":
			_use_helper(Library.WORLD_TO_SCREEN_HELPER)
			code = "_brickscript_world_to_screen(%s, %s, %s)" % [args["camera"][0], args["position"][0], brick]
			type = T.VECTOR2
			extra = [&"on_screen_name", "_brickscript_on_screen", T.BOOL]
	var name: String = str(node.settings.get(extra[0], "")).strip_edges()
	var lines: PackedStringArray = []
	if node.output_name.strip_edges().is_empty() and not name.is_empty():
		lines.append(code)
	else:
		lines = _output(node, code, type, where)
		if lines.is_empty():
			return []
	if not name.is_empty():
		if not _exists(name):
			if not _check_name(name, where + " > " + String(extra[0]).trim_suffix("_name")):
				return []
			_new_chain_variable(name, extra[2])
		var assigned: PackedStringArray = _assign(name, extra[1], extra[2], where)
		if assigned.is_empty():
			return []
		lines.append_array(assigned)
	return lines


## "<title> (brick <id>)" as GDScript text: how a helper names the brick in
## an error when the game runs.
func _brick_label(node: BrickscriptFlowNode) -> String:
	return var_to_str("%s (brick %d)" % [Library.get_definition(node.type)["title"], node.id])


## Get node, Get / Set property, Call method, Spawn scene.
func _node_brick(node: BrickscriptFlowNode, definition: Dictionary, where: String) -> PackedStringArray:
	match node.type:
		&"get_node":
			var path: String = str(node.settings.get(&"path", "")).strip_edges()
			var node_type: Dictionary = _node_type_setting(node, where)
			if _script_node and path in ["", ".", ".."]:
				var found: Array = _script_node_path(path, {})
				return _output(node, found[0], T.NODE, where, found[2] if node_type.is_empty() else node_type)
			if path.is_empty() or path == ".":
				return _output(node, _self_code, T.NODE, where, _self_type if node_type.is_empty() else node_type)
			var from: String = "%s." % _self_code if _body and not _script_node else ""
			if _script_node and path.begins_with("../"):
				# From the node it works for (Self.Parent).
				from = "_brickscript_body."
				path = path.trim_prefix("../")
			var code: String = "%sget_node_or_null(%s)" % [from, var_to_str(NodePath(path))]
			if not node_type.is_empty():
				code = _typed(code, node_type, node) + " as " + NodeTypes.gd_class(node_type)
			return _output(node, code, T.NODE, where, node_type)
		&"spawn_scene":
			return _spawn_scene(node, definition, where)
		&"emit_signal":
			return _emit_signal(node, where)
		&"host", &"join":
			var args: PackedStringArray = []
			for spec: Dictionary in Ops.input_specs(node):
				var given: Array = _input(node, spec, where)
				if given.is_empty():
					return []
				args.append(given[0])
			_use_helper(Library.CONNECT_HELPER)
			var call: String = "_brickscript_connect(&\"%s\", [%s])" % [node.type, ", ".join(args)]
			if node.output_name.strip_edges().is_empty():
				return [call]
			return _output(node, "%s == OK" % call, T.BOOL, where)
		&"find_node":
			var wanted: Array = _input(node, definition["inputs"][0], where)
			var under: Array = _input(node, definition["inputs"][1], where) if not wanted.is_empty() else []
			if under.is_empty():
				return []
			var node_type: Dictionary = _node_type_setting(node, where)
			var recursive: bool = str(node.settings.get(&"search", "All descendants")) != "Direct children"
			var code: String = "%s.find_child(%s, %s, false)" % [under[0], wanted[0], "true" if recursive else "false"]
			if not node_type.is_empty():
				code = _typed(code, node_type, node) + " as " + NodeTypes.gd_class(node_type)
			return _output(node, code, T.NODE, where, node_type)
		&"get_root":
			var node_type: Dictionary = _node_type_setting(node, where)
			var code: String = ""
			if str(node.settings.get(&"root", Library.ROOT_OF[0])) == Library.ROOT_OF[1]:
				_use_helper(Library.GAME_ROOT_HELPER)
				code = "_brickscript_game_root(self)"
			else:
				var of: Array = _input(node, definition["inputs"][0], where)
				if of.is_empty():
					return []
				_use_helper(Library.SCENE_ROOT_HELPER)
				code = "_brickscript_scene_root(%s)" % of[0]
			if not node_type.is_empty():
				code = _typed(code, node_type, node) + " as " + NodeTypes.gd_class(node_type)
			return _output(node, code, T.NODE, where, node_type)
		&"find_ancestor":
			var wanted: Array = _input(node, definition["inputs"][0], where)
			var of: Array = _input(node, definition["inputs"][1], where) if not wanted.is_empty() else []
			if of.is_empty():
				return []
			var node_type: Dictionary = _node_type_setting(node, where)
			var fits: String = "Callable()"
			if not node_type.is_empty() and NodeTypes.gd_class(node_type) != "Node":
				fits = "func(found: Node) -> bool: return found is %s" % NodeTypes.gd_class(node_type)
			_use_helper(Library.ANCESTOR_HELPER)
			var code: String = "_brickscript_find_ancestor(%s, %s, %s)" % [of[0], wanted[0], fits]
			if fits != "Callable()":
				code += " as " + NodeTypes.gd_class(node_type)
			return _output(node, code, T.NODE, where, node_type)
		&"as_script":
			var given: Array = _input(node, definition["inputs"][0], where)
			if given.is_empty():
				return []
			var script: String = str(node.settings.get(&"node_script", "")).strip_edges()
			if script.is_empty():
				errors.append("%s > Script: pick the script the node should run" % where)
				return []
			if not ResourceLoader.exists(script) and not FileAccess.file_exists(script):
				warnings.append("%s > Script: %s doesn't exist (yet)" % [where, script])
			var node_type: Dictionary = _node_type_setting(node, where)
			if not NodeTypes.fits(given[2], node_type):
				errors.append("%s: a %s can't run %s (it extends %s)" % [where, NodeTypes.describe(given[2]), script.get_file(), node_type.get("class", "Node")])
				return []
			_use_helper(Library.AS_SCRIPT_HELPER)
			var code: String = "_brickscript_as_script(%s, %s)" % [given[0], var_to_str(script)]
			if NodeTypes.gd_class(node_type) != "Node":
				code += " as " + NodeTypes.gd_class(node_type)
			return _output(node, code, T.NODE, where, node_type)
		&"bodies_near", &"raycast":
			return _physics_query(node, definition, where)
		&"find_path":
			return _find_path(node, definition, where)
		&"terrain_ray":
			return _terrain_ray(node, definition, where)
		&"random_open_spot":
			return _open_spot(node, definition, where)
		&"nearest_character":
			return _nearest_character(node, definition, where)
		&"screen_to_world", &"player_aim", &"world_to_screen":
			return _camera_brick(node, definition, where)
		&"get_character":
			var by_id: bool = str(node.settings.get(&"from", Library.CHARACTER_FROM[0])) == Library.CHARACTER_FROM[1]
			var given: Array = _input(node, definition["inputs"][1 if by_id else 0], where)
			if given.is_empty():
				return []
			var node_type: Dictionary = _node_type_setting(node, where)
			_use_helper(Library.CHARACTER_OF_HELPER)
			var peer: String = _peer_code(given)
			if by_id:
				_use_helper(Library.USER_ID_HELPER)
				_use_helper(Library.PLAYER_NODE_HELPER)
				peer = "_brickscript_peer(_brickscript_player_with_user_id(%s))" % given[0]
			var found: String = "_brickscript_character_of(%s)" % peer
			if NodeTypes.gd_class(node_type) != "Node":
				found += " as " + NodeTypes.gd_class(node_type)
			return _output(node, found, T.NODE, where, node_type)
		&"get_player":
			var by_id: bool = str(node.settings.get(&"from", Library.PLAYER_FROM[0])) == Library.PLAYER_FROM[1]
			var given: Array = _input(node, definition["inputs"][1 if by_id else 0], where)
			if given.is_empty():
				return []
			_use_helper(Library.PLAYER_NODE_HELPER)
			if by_id:
				_use_helper(Library.USER_ID_HELPER)
				return _output(node, "_brickscript_player_with_user_id(%s)" % given[0], T.PLAYER, where)
			# (A character's player: whose it is, as Owner.)
			_use_helper(Library.PLAYER_OF_HELPER)
			return _output(node, "_brickscript_player(_brickscript_player_of(%s))" % given[0], T.PLAYER, where)
		&"get_children", &"nodes_in_group":
			var node_type: Dictionary = _node_type_setting(node, where)
			var code: String = ""
			if node.type == &"get_children":
				var of: Array = _input(node, definition["inputs"][0], where)
				if of.is_empty():
					return []
				var recursive: bool = str(node.settings.get(&"search", "Direct children")) == "All descendants"
				code = "%s.find_children(\"*\", %s, %s, false)" % [of[0], var_to_str(String(node_type.get("class", "")) if node_type.get("class", &"Node") != &"Node" else ""), "true" if recursive else "false"]
			else:
				var group: String = str(node.settings.get(&"group", "")).strip_edges()
				if group.is_empty():
					errors.append("%s > group: is empty" % where)
					return []
				code = "get_tree().get_nodes_in_group(%s)" % var_to_str(StringName(group))
				if node_type.get("class", &"Node") != &"Node":
					code += ".filter(func(found: Node) -> bool: return found is %s)" % NodeTypes.gd_class(node_type)
			if not str(node_type.get("script", "")).is_empty():
				code += ".filter(func(found: Node) -> bool: return found.get_script() != null and found.get_script().resource_path == %s)" % var_to_str(node_type["script"])
			# A List of its node type (Godot gives an Array[Node]).
			var list: Dictionary = NodeTypes.list_info(T.NODE, node_type)
			if NodeTypes.gd_class(node_type) != "Node":
				code = NodeTypes.list_converted(code, list, "convert")
			return _output(node, code, T.LIST, where, list)
	var target: Array = _input(node, definition["inputs"][0], where)
	if target.is_empty():
		return []
	var kind: String = "method" if node.type == &"call_method" else "signal" if node.type == &"wait_for_signal" else "property"
	var setting: StringName = &"method" if node.type == &"call_method" else &"signal" if node.type == &"wait_for_signal" else &"property"
	var member_name: String = str(node.settings.get(setting, "")).strip_edges()
	if not member_name.is_valid_ascii_identifier():
		errors.append("%s > %s: %s" % [where, setting, "pick one" if member_name.is_empty() else "'%s' is not a valid name" % member_name])
		return []
	var member: Dictionary = _find_member(target[2], member_name, kind)
	if member.is_empty():
		warnings.append("%s > %s: '%s' isn't known on %s; it's used by name when the game runs" % [where, setting, member_name, _describe(target[2])])
		member = {"name": member_name, "kind": kind, "type": T.ANY, "node": {}, "native": false, "writable": true, "args": [], "required": -1}
	var reading: bool = node.type == &"set_property" and Library.mode_of(node) == "Get"
	if node.type == &"set_property" and not reading and _is_character(target[2]) and Library.CHARACTER_PROPERTIES.has(member_name):
		return _character_setting(node, definition, target, member, where)
	match node.type:
		&"set_property" when reading:
			return _output(node, _as_text_if_path(_member_read(target[0], member), member.get("node", {})), member["type"], where, member.get("node", {}))
		&"set_property" when _adding(node):
			var amount: Array = _input(node, definition["inputs"][1], where)
			if amount.is_empty() or not _can_set(member, target, where):
				return []
			if not member["type"] in Library.ADDABLE_TYPES:
				errors.append("%s: '%s' is a %s; only numbers and vectors can be added to (Mode: Set)" % [where, member_name, Types.type_name(member["type"])])
				return []
			if Types.VECTORS.has(member["type"]) and Types.NUMERIC.has(amount[1]):
				errors.append("%s > value: '%s' is a %s; add a %s to it" % [where, member_name, Types.type_name(member["type"]), Types.type_name(member["type"])])
				return []
			if not _value_fits(amount, member, where + " > value"):
				return []
			var added: String = _rounded(amount, member)
			var guard: String = _local_guard(node, target, where, member)
			if guard == LOCAL_REFUSED:
				return []
			if member["native"] or member.get("own", false):
				return _guarded(guard, "%s += %s" % [_member_target(target[0], member), added])
			return _guarded(guard, _member_write(target[0], member, "%s + %s" % [_member_read(target[0], member), added]))
		&"set_property":
			var value: Array = _input(node, definition["inputs"][1], where)
			if value.is_empty() or not _can_set(member, target, where):
				return []
			if member["type"] == T.RESOURCE and value[1] == T.TEXT:
				value = _loaded(value)
			if not _value_fits(value, member, where + " > value"):
				return []
			var guard: String = _local_guard(node, target, where, member)
			if guard == LOCAL_REFUSED:
				return []
			return _guarded(guard, _member_write(target[0], member, _as_path_if_path(_rounded(value, member), member.get("node", {}))))
		&"call_method":
			return _call_method(node, target, member, where)
		&"wait_for_signal":
			return ["await Signal(%s, %s)" % [target[0], var_to_str(StringName(member_name))]]
	return []


## Property / Variable in Add mode (property += value).
static func _adding(node: BrickscriptFlowNode) -> bool:
	return Library.mode_of(node) == "Add"


## Whether a node type is a character node (BrickscriptCharacter3D / 2D, or
## a script extending one).
func _is_character(node_type: Dictionary) -> bool:
	var path: String = str(node_type.get("script", ""))
	if path.is_empty() or BrickFile.is_script_path(path) or not ResourceLoader.exists(path):
		return false
	var script: Script = load(path) as Script
	while script != null:
		if Library.CHARACTER_SCRIPTS.has(script.resource_path):
			return true
		script = script.get_base_script()
	return false


## Set property (Set / Add) of a character's setting (Library.CHARACTER_PROPERTIES):
## through its change(), so it reaches the machine that moves it (a local
## brickscript may change its own player's character: change() refuses
## anything else); Health / Max health only in a server brickscript.
func _character_setting(node: BrickscriptFlowNode, definition: Dictionary, target: Array, member: Dictionary, where: String) -> PackedStringArray:
	var name: String = member["name"]
	if Library.CHARACTER_SERVER_PROPERTIES.has(name) and not _server:
		errors.append("%s: a character's %s is set by the server only (a server brickscript; or Damage / Heal there)" % [where, name])
		return []
	var given: Array = _input(node, definition["inputs"][1], where)
	if given.is_empty() or not _value_fits(given, member, where + " > value"):
		return []
	var value: String = _rounded(given, member)
	if member["type"] == T.NUMBER and given[1] == T.WHOLE:
		value = "float(%s)" % value
	if _adding(node):
		if not member["type"] in [T.ANY, T.NUMBER, T.WHOLE]:
			errors.append("%s: '%s' is a %s; only numbers can be added to (Mode: Set)" % [where, name, Types.type_name(member["type"])])
			return []
		value = "%s + %s" % [_member_read(target[0], member), value]
	_use_helper(Library.CHARACTER_HELPER)
	return ["_brickscript_set_character(%s, &%s, %s, 0.0, %s)" % [target[0], var_to_str(name), value, _brick_label(node)]]


## When signal received: its own function (parameters typed from the
## signal, provided as values), connected at the start of _ready. A signal
## that isn't known gets its values as the List `values`.
func _signal_event(event: BrickscriptFlowNode, definition: Dictionary) -> Dictionary:
	var where: String = _where(event, definition)
	var signal_name: String = str(event.settings.get(&"signal", "")).strip_edges()
	if not signal_name.is_valid_ascii_identifier():
		errors.append("%s > signal: %s" % [where, "pick one" if signal_name.is_empty() else "'%s' is not a valid name" % signal_name])
		return {}
	var path: String = str(event.settings.get(&"path", "")).strip_edges()
	var this_node: bool = path.is_empty() or path == "."
	var node_type: Dictionary = _node_type_setting(event, where)
	if this_node and node_type.is_empty():
		node_type = _own_type if _script_node else _self_type
	var member: Dictionary = _own_signal(signal_name) if this_node else {}
	var source: String = "self" if this_node and _script_node else _script_node_path(path, {})[0] if _script_node else ""
	if _script_node and path == ".." and node_type.is_empty():
		node_type = _self_type
	# This brickscript's own signal is emitted by this script itself (in a
	# server brickscript, the server part, not the node it belongs to).
	var own: bool = not member.is_empty()
	if member.is_empty():
		member = _find_member(node_type, signal_name, "signal")
	if _server and not own and not member.is_empty() and not member.get("native", true) and _is_local_script(str(node_type.get("script", ""))):
		errors.append(LOCAL_SIGNAL_REFUSED % [where, signal_name, str(node_type["script"]).get_file()])
		return {}
	var made: Dictionary = definition.duplicate()
	made["function"] = "_brickscript_signal_%d" % event.id
	var params: Array = []
	var provides: Dictionary = {}
	var provided_nodes: Dictionary = {}
	if member.is_empty():
		warnings.append("%s > signal: '%s' isn't known on %s; its values arrive as the List values" % [where, signal_name, _describe(node_type)])
		params = [["values", "Array", true]]
		provides = {"values": T.LIST}
	else:
		for i: int in member["args"].size():
			var arg: String = member["arg_names"][i]
			var type: int = member["args"][i]
			if not arg.is_valid_ascii_identifier() or _script.has(arg) or _implicit.has(arg) or RESERVED_NAMES.has(arg):
				errors.append("%s: the signal's value '%s' has the name of a variable or keyword; rename that variable" % [where, arg])
				return {}
			if member["arg_nodes"][i].get("path", false):
				# A signal's node path arrives as it is: Anything (str() it).
				type = T.ANY
			params.append([arg, _gd_type(type, member["arg_nodes"][i])])
			provides[arg] = type
			provided_nodes[arg] = member["arg_nodes"][i]
	made["function_params"] = params
	made["provides"] = provides
	made["provided_nodes"] = provided_nodes
	if source.is_empty():
		source = "self" if own else _self_code if this_node else "%sget_node(%s)" % ["%s." % _self_code if _body else "", var_to_str(NodePath(path))]
	if _server and not own:
		# Checked again when it runs: a node's script can't always be known.
		_use_helper(Library.SERVER_SIGNAL_HELPER)
		_setup.append("\t_brickscript_listen(%s, %s, %s)" % [source, var_to_str(StringName(signal_name)), made["function"]])
	else:
		_setup.append("\t%s.connect(%s, %s)" % [source, var_to_str(StringName(signal_name)), made["function"]])
	return made


## A local script's path: a .bricklocal or a .local.gd.
static func _is_local_script(path: String) -> bool:
	return path.ends_with(".bricklocal") or path.ends_with(".local.gd")


## When character spawned: its own function (player, character), connected
## to the Character Spawners (deferred: they may be ready after this node).
func _spawner_event(event: BrickscriptFlowNode, definition: Dictionary) -> Dictionary:
	var made: Dictionary = definition.duplicate()
	made["function"] = "_brickscript_spawned_%d" % event.id
	made["function_params"] = [["player", "int"], ["character", "Node"]]
	_use_helper(Library.SPAWNED_HELPER)
	_setup.append("\t_brickscript_on_spawned.call_deferred(%s)" % made["function"])
	return made


## When character died: its own function (character, player, killer: the
## numbers become Players), heard through Library.DIED_HELPER (dying
## characters call every listening brickscript).
func _died_event(event: BrickscriptFlowNode, definition: Dictionary) -> Dictionary:
	var made: Dictionary = definition.duplicate()
	made["function"] = "_brickscript_died_%d" % event.id
	made["function_params"] = [["character", "Node"], ["player", "int"], ["killer", "int"]]
	var whose: int = maxi(Library.DIED_WHOSE.find(str(event.settings.get(&"whose", Library.DIED_WHOSE[0]))), 0)
	_use_helper(Library.DIED_HELPER)
	_setup.append("\t_brickscript_hear_deaths(%s, %d, %s)" % [made["function"], whose, _self_code])
	return made


## When culled / shown: its own function (node, culled), connected to the
## Cull Throttle Engine's culled_here_changed in _ready (Library.CULL_HELPER).
func _culled_event(event: BrickscriptFlowNode, definition: Dictionary) -> Dictionary:
	var made: Dictionary = definition.duplicate()
	made["function"] = "_brickscript_culled_%d" % event.id
	made["function_params"] = [["node", "Node3D"], ["culled", "bool"]]
	var which: int = maxi(Library.CULL_WHICH.find(str(event.settings.get(&"which", Library.CULL_WHICH[0]))), 0)
	var any: bool = str(event.settings.get(&"whose", Library.CULL_WHOSE[0])) == Library.CULL_WHOSE[1]
	_use_helper(Library.CULL_HELPER)
	_setup.append("\t_brickscript_hear_culling(%s, %d, %s)" % [made["function"], which, "null" if any else _self_code])
	return made


## When terrain ready / cleared: its own function (terrain), connected at the
## start of _ready to every Terrain's terrain_ready / cleared
## (Library.TERRAIN_READY_HELPER / TERRAIN_CLEARED_HELPER). Its terrain is
## typed as a Terrain (2026-11-02), so later bricks know its members.
func _terrain_event(event: BrickscriptFlowNode, definition: Dictionary) -> Dictionary:
	var made: Dictionary = definition.duplicate()
	var cleared: bool = definition["terrain_signal"] == &"cleared"
	made["function"] = "_brickscript_terrain_%s_%d" % ["cleared" if cleared else "ready", event.id]
	made["function_params"] = [["terrain", "Node3D"]]
	made["provided_nodes"] = {"terrain": terrain_type()}
	_use_helper(Library.TERRAIN_CLEARED_HELPER if cleared else Library.TERRAIN_READY_HELPER)
	_setup.append("\t_brickscript_on_terrain_%s(%s)" % ["cleared" if cleared else "ready", made["function"]])
	return made


## A Terrain's node type: the Terrain Engine's script when the plugin is
## there, else a plain Node3D (Brickscript works without it).
static func terrain_type() -> Dictionary:
	if ResourceLoader.exists(Library.TERRAIN_SCRIPT):
		return {"class": &"Node3D", "script": Library.TERRAIN_SCRIPT}
	return {"class": &"Node3D"}


## Whether a node of this type can be a Terrain: unknown or plain types
## might (checked when it runs); another script or a non-3D class can't.
func _could_be_terrain(node_type: Dictionary) -> bool:
	if not _is_class(node_type, &"Node3D"):
		return false
	var script_path: String = str(node_type.get("script", ""))
	if script_path.is_empty() or script_path == Library.TERRAIN_SCRIPT or not ResourceLoader.exists(script_path) or not ResourceLoader.exists(Library.TERRAIN_SCRIPT):
		return true
	var script: Script = load(script_path) as Script
	var wanted: Script = load(Library.TERRAIN_SCRIPT) as Script
	while script != null:
		if script == wanted:
			return true
		script = script.get_base_script()
	return false


## Player Joined / leaves: its own function (peer: int), connected
## at the start of _ready through the engine (and run for players already
## there, see Library.PLAYERS_HELPER).
func _players_event(event: BrickscriptFlowNode, definition: Dictionary) -> Dictionary:
	var made: Dictionary = definition.duplicate()
	made["function"] = "_brickscript_player_%s_%d" % [String(definition["players_signal"]).trim_prefix("player_"), event.id]
	made["function_params"] = definition.get("players_params", [["player", "int"]])
	_use_helper(Library.PLAYERS_HELPER)
	_setup.append("\t_brickscript_on_players(%s, %s)" % [var_to_str(definition["players_signal"]), made["function"]])
	return made


## Player Value Changed: its own function (player, value_name, value),
## connected to the Players node (Library.PLAYER_VALUES_HELPER). Whose: Me
## adds `player.is_me()` to the guard.
func _player_values_event(event: BrickscriptFlowNode, definition: Dictionary) -> Dictionary:
	var made: Dictionary = definition.duplicate()
	made["function"] = "_brickscript_value_changed_%d" % event.id
	made["function_params"] = [["player", "BrickscriptPlayer"], ["value_name", "String"], ["value", "Variant"]]
	if str(event.settings.get(&"whose", Library.VALUE_WHOSE[0])) == Library.VALUE_WHOSE[1]:
		made["guard"] = definition["guard"] + " and player.is_me()"
	_use_helper(Library.PLAYER_VALUES_HELPER)
	_setup.append("\t_brickscript_on_player_values(%s)" % made["function"])
	return made


## Player Renamed: its own function (player, new_name), connected to every
## player node's renamed (Library.PLAYER_RENAMED_HELPER). Whose: Me guards
## with `player.is_me()`.
func _player_renamed_event(event: BrickscriptFlowNode, definition: Dictionary) -> Dictionary:
	var made: Dictionary = definition.duplicate()
	made["function"] = "_brickscript_player_renamed_%d" % event.id
	made["function_params"] = [["player", "BrickscriptPlayer"], ["new_name", "String"]]
	if str(event.settings.get(&"whose", Library.VALUE_WHOSE[0])) == Library.VALUE_WHOSE[1]:
		made["guard"] = "player.is_me()"
	_use_helper(Library.PLAYER_RENAMED_HELPER)
	_setup.append("\t_brickscript_on_player_renamed(%s)" % made["function"])
	return made


## Player Pressed / releases (server): its own function
## (player, action), connected at the start of _ready to the engine's signal.
## Player Holding: its own function (player, delta), called from
## _process for each player holding the action. "This node's player" adds
## `player == Owner` to the guard.
func _input_event(event: BrickscriptFlowNode, definition: Dictionary) -> Dictionary:
	var made: Dictionary = definition.duplicate()
	var action: String = str(event.settings.get(&"action", "")).strip_edges()
	var own: String = "_brickscript_peer(player) == _brickscript_player_of(%s)" % _self_code
	_use_helper(Library.PLAYER_NODE_HELPER)
	if str(event.settings.get(&"whose", Library.PLAYER_WHOSE[0])) == Library.PLAYER_WHOSE[1]:
		_use_helper(Library.PLAYER_OF_HELPER)
		made["guard"] = own if definition.get("guard", "").is_empty() else definition["guard"] + " and " + own
	if definition.has("input_signal"):
		made["function"] = "_brickscript_%s_%d" % [String(definition["input_signal"]).trim_prefix("player_"), event.id]
		made["function_params"] = [["player", "int"], ["action", "StringName"]]
		_use_helper(Library.PLAYER_ACTIONS_HELPER)
		(_predicted_setup if _event_predicted else _setup).append("\t_brickscript_on_player_actions(%s, %s)" % [var_to_str(definition["input_signal"]), made["function"]])
		return made
	made["function"] = "_brickscript_held_%d" % event.id
	made["function_params"] = [["player", "int"], ["delta", "float"]]
	if action.is_empty():
		errors.append("%s > action: is empty" % _where(event, definition))
		return made
	if not ProjectSettings.has_setting("input/" + action):
		warnings.append("%s > action: '%s' is not in the project's Input Map" % [_where(event, definition), action])
	_use_helper(Library.PLAYERS_HOLDING_HELPER)
	var process: Dictionary = _functions.get_or_add("_process", {"params": Library.PROCESS_PARAMS, "lines": [], "used": {}, "names": {}, "annotation": "", "prelude": ""})
	process["used"]["delta"] = true
	if _event_predicted:
		_predicted_functions["_process"] = true
		process["lines"].append("\tfor _holder: int in _brickscript_players_holding(%s):%s" % [var_to_str(StringName(action)), marker(event.id)])
		process["lines"].append("\t\t%s(_holder, delta)%s" % [made["function"], marker(event.id)])
	else:
		# (With predicted events, _process runs on the player's machine too.)
		var pad: String = "\t\t" if _any_predicted else "\t"
		if _any_predicted:
			process["lines"].append("\tif _brickscript_has_server_authority():%s" % marker(event.id))
		process["lines"].append("%sfor _holder: int in _brickscript_players_holding(%s):%s" % [pad, var_to_str(StringName(action)), marker(event.id)])
		process["lines"].append("%s\t%s(_holder, delta)%s" % [pad, made["function"], marker(event.id)])
	return made


## A predicted event's chain may only move things: bricks that would happen
## twice (or where only the server may) are refused.
func _check_predicted_chain(event: BrickscriptFlowNode, definition: Dictionary) -> void:
	var seen: Dictionary[int, bool] = {}
	var waiting: Array = event.exits.values()
	while not waiting.is_empty():
		var node: BrickscriptFlowNode = _nodes.get(int(waiting.pop_back()))
		if node == null or seen.has(node.id):
			continue
		seen[node.id] = true
		if Library.PREDICT_REFUSED.has(node.type) or Library.get_definition(node.type).get("waits", false):
			errors.append("%s: Runs on: predicted, so it also runs on the player's machine, where %s would happen again (or can't: only the server may). Put it in an event that Runs on: The server" % [_where(node, Library.get_definition(node.type)), Library.get_definition(node.type)["title"]])
		waiting.append_array(node.exits.values())


## Sync: registered at the start of _ready on every machine.
func _sync_declaration(node: BrickscriptFlowNode) -> void:
	var where: String = _where(node, Library.get_definition(node.type))
	var property: String = str(node.settings.get(&"property", "")).strip_edges()
	if not property.is_valid_ascii_identifier():
		errors.append("%s > property: %s" % [where, "pick one" if property.is_empty() else "'%s' is not a valid name" % property])
		return
	var path: String = str(node.settings.get(&"path", "")).strip_edges()
	var this_node: bool = path.is_empty() or path == "."
	var node_type: Dictionary = _node_type_setting(node, where)
	if node_type.is_empty() and _script_node and path in ["", ".", ".."]:
		node_type = _script_node_path(path, {})[2]
	elif this_node and node_type.is_empty():
		node_type = _self_type
	var member: Dictionary = _find_member(node_type, property, "property")
	if member.is_empty() and this_node:
		# Self's type is known exactly (this node and this brickscript), so
		# it hasn't got it: syncing it would sync nothing.
		var hint: String = " (Self is the script node: for the node it acts for, pick Node Self.Parent)" if _script_node else ""
		errors.append("%s > property: %s has no property '%s'%s" % [where, _describe(node_type), property, hint])
		return
	if member.is_empty():
		warnings.append("%s > property: '%s' isn't known on %s; it's synced by name" % [where, property, _describe(node_type)])
	elif not member["writable"]:
		errors.append("%s > property: '%s' can't be changed, so it can't be synced" % [where, property])
		return
	var target: String = _script_node_path(path, {})[0] if _script_node else _self_code if this_node else "%s.get_node(%s)" % [_self_code, var_to_str(NodePath(path))]
	_use_helper(Library.SYNC_HELPER)
	_setup.append("\t_brickscript_sync(%s, %s, %s)" % [target, var_to_str(property), "false" if str(node.settings.get(&"smooth", "Smooth")) == "Jump" else "true"])


## A signal this brickscript itself emits, as a member (from the first
## pass), or {}.
func _own_signal(name: String) -> Dictionary:
	var known: Dictionary = _signals.get(name, _prior_signals.get(name, {}))
	if known.is_empty():
		return {}
	var names: PackedStringArray = []
	for i: int in known["types"].size():
		names.append("value_%d" % (i + 1))
	return {"name": name, "kind": "signal", "args": known["types"], "arg_names": names, "arg_nodes": known["nodes"]}


## Emit signal: `name.emit(values)`; the signal is declared from its values,
## which every Emit signal of it must agree on.
func _emit_signal(node: BrickscriptFlowNode, where: String) -> PackedStringArray:
	var name: String = str(node.settings.get(&"signal", "")).strip_edges()
	if name.is_empty():
		errors.append("%s > signal: is empty" % where)
		return []
	if not _check_name(name, where + " > signal"):
		return []
	if _script.has(name) or _implicit.has(name):
		errors.append("%s > signal: '%s' is also a variable" % [where, name])
		return []
	var codes: PackedStringArray = []
	var types: Array[int] = []
	var nodes: Array[Dictionary] = []
	for spec: Dictionary in Ops.input_specs(node):
		var given: Array = _input(node, spec, where)
		if given.is_empty():
			return []
		codes.append(given[0])
		types.append(given[1])
		# Signals carry Lists untyped (whatever their items).
		nodes.append(given[2] if given[1] != T.LIST else {})
	if _signals.has(name):
		var known: Array = _signals[name]["types"]
		var same: bool = known.size() == types.size()
		for i: int in mini(known.size(), types.size()):
			same = same and Types.fits(types[i], known[i])
		if not same:
			var wanted: PackedStringArray = []
			for type: int in known:
				wanted.append(Types.type_name(type))
			errors.append("%s: '%s' is emitted elsewhere with (%s); every Emit signal of it must send the same kinds of values" % [where, name, ", ".join(wanted)])
			return []
	else:
		_signals[name] = {"types": types, "nodes": nodes}
	return ["%s.emit(%s)" % [name, ", ".join(codes)]]


func _spawn_scene(node: BrickscriptFlowNode, definition: Dictionary, where: String) -> PackedStringArray:
	var scene: String = str(node.settings.get(&"scene", "")).strip_edges()
	if scene.is_empty():
		errors.append("%s > scene: pick a scene (.tscn)" % where)
		return []
	if not scene.begins_with("res://") or not scene.get_extension() in ["tscn", "scn"]:
		errors.append("%s > scene: '%s' is not a scene file (res://... .tscn)" % [where, scene])
		return []
	if not ResourceLoader.exists(scene):
		warnings.append("%s > scene: %s doesn't exist (yet)" % [where, scene])
	var parent: Array = _input(node, definition["inputs"][0], where)
	if parent.is_empty():
		return []
	var at: Array = []
	if Ops.input_shown(node, &"at"):
		at = _input(node, definition["inputs"][1], where)
		if at.is_empty():
			return []
	var node_type: Dictionary = _node_type_setting(node, where)
	var for_whom: String = str(node.settings.get(&"for", Library.SPAWN_FOR[0]))
	var player: Array = []
	if for_whom != Library.SPAWN_FOR[0]:
		if not _server:
			errors.append("%s > For: only a server brickscript spawns for a player (a local one only spawns effects, no one's)" % where)
			return []
		player = _input(node, Library.get_definition(&"spawn_scene")["inputs"][2], where)
		if player.is_empty():
			return []
	if _server:
		# Spawned for every machine (the engine adds it to the parent), placed
		# before it's added, so every machine gets it there; a player's from
		# the start (For).
		_use_helper(Library.SPAWN_HELPER)
		var whose: String = "" if player.is_empty() else ", %s, %s" % [_peer_code(player), "true" if for_whom == Library.SPAWN_FOR[2] else "false"]
		var spawned: String = "_brickscript_spawn(load(%s), %s, %s%s)" % [var_to_str(scene), parent[0], "{\"position\": %s}" % at[0] if not at.is_empty() else "{}", whose]
		if not node_type.is_empty():
			spawned += " as " + NodeTypes.gd_class(node_type)
		return _parent_checked(node, parent[0], [spawned] if node.output_name.strip_edges().is_empty() else _output(node, spawned, T.NODE, where, node_type))
	# Local: an effect only this machine sees (never synced, so it can't be
	# part of the game: no bodies or areas).
	var bodies: PackedStringArray = NodeTypes.scene_bodies(scene)
	if not bodies.is_empty():
		errors.append("%s > scene: a local brickscript only spawns effects (this machine alone sees them), and %s has physics: %s. Spawn it from the server brickscript." % [where, scene.get_file(), ", ".join(bodies)])
		return []
	_use_helper(Library.LOCAL_SPAWN_HELPER)
	node_type = node_type.duplicate()
	node_type["local"] = true
	var made: String = "_brickscript_local_spawn((load(%s) as PackedScene).instantiate())" % var_to_str(scene)
	if NodeTypes.gd_class(node_type) != "Node":
		made += " as " + NodeTypes.gd_class(node_type)
	var name: String = node.output_name.strip_edges()
	if name.is_empty() and not at.is_empty():
		errors.append("%s: to place it, keep it in an Output Var" % where)
		return []
	if name.is_empty():
		return _parent_checked(node, parent[0], ["%s.add_child(%s)" % [parent[0], made]])
	var lines: PackedStringArray = _output(node, made, T.NODE, where, node_type)
	if lines.is_empty():
		return []
	if not at.is_empty():
		lines.append("%s.position = %s" % [_read(name, where)[0], at[0]])
	lines.append("%s.add_child(%s)" % [parent[0], _read(name, where)[0]])
	return _parent_checked(node, parent[0], lines)


## A node found by path or name, checked against the brick's Type when the
## game runs: a node of another class is reported (naming the brick) instead
## of quietly becoming null at the `as`.
func _typed(code: String, node_type: Dictionary, node: BrickscriptFlowNode) -> String:
	var class_name_: String = NodeTypes.gd_class(node_type)
	if class_name_ == "Node":
		return code
	_use_helper(Library.TYPED_NODE_HELPER)
	return "_brickscript_typed(%s, &%s, %s)" % [code, var_to_str(class_name_), _brick_label(node)]


## A local brickscript's change to a node: allowed only on local-only nodes
## (NodeTypes.is_local_only), or its own variables (`member` is one of
## this script's), checked by the node's Type here and by
## _brickscript_local_only when the game runs. Returns the "if ...: " the
## line starts with ("" in a server brickscript), or LOCAL_REFUSED (error
## recorded).
func _local_guard(node: BrickscriptFlowNode, target: Array, where: String, member: Dictionary = {}) -> String:
	if _server:
		return ""
	if member.get("const", false):
		# A Godot method that only reads (get_child_count, is_on_floor...).
		return ""
	if member.get("own", false) and target[2].get("self", false):
		# Its own variables are its own memory (like Set Var), except Synced
		# ones: the server sets those.
		if _synced.has(String(member["name"])):
			errors.append(SYNCED_BY_SERVER % [where, member["name"]])
			return LOCAL_REFUSED
		return ""
	# The node it acts for, or a body a player moves (their character): this
	# machine's player may own it, which is only known when the game runs.
	var could_be_owned: bool = target[2].get("acts_for", false) or NodeTypes.is_movable(target[2])
	if not NodeTypes.is_local_only(target[2]) and not could_be_owned:
		var what: String = _describe(target[2]) if target[2].get("acts_for", false) else "a %s" % _describe(target[2])
		errors.append("%s: a local brickscript only changes what this machine alone sees (UI, cameras, sounds, particles, or what it spawned itself), not %s. Do it in the server brickscript%s." % [where, what, "" if not target[2].is_empty() else ", or set the node's Type if it is one of those"])
		return LOCAL_REFUSED
	_use_helper(Library.LOCAL_ONLY_HELPER)
	return "if _brickscript_local_only(%s, %s): " % [target[0], _brick_label(node)]


## A local change behind its guard (_local_guard(): "" or "if <allowed>: "):
## refused when the game runs, it stops the chain there (BUGS.md
## 2026-10-31: the rest ran as if it had worked); in a function brick it's
## only skipped (a function may have to return a value).
## Spawn scene's lines after a check that its parent is there (else an
## error naming the brick; in an event the chain stops there).
func _parent_checked(node: BrickscriptFlowNode, parent: String, lines: PackedStringArray) -> PackedStringArray:
	if lines.is_empty():
		return lines
	_use_helper(Library.SPAWN_PARENT_HELPER)
	var check: String = "_brickscript_spawn_parent(%s, %s)" % [parent, _brick_label(node)]
	if _event_type == &"define_function":
		# (A function's chain can't just return, and its Output Var must
		# stay declared: it only says so.)
		return PackedStringArray([check]) + lines
	_event_stops = true
	return PackedStringArray(["if not %s: return" % check]) + lines


func _guarded(guard: String, statement: String) -> PackedStringArray:
	if guard.is_empty():
		return PackedStringArray([statement])
	if _event_type == &"define_function":
		return PackedStringArray([guard + statement])
	_event_stops = true
	return PackedStringArray(["if not %s: return" % guard.trim_prefix("if ").trim_suffix(": "), statement])


func _call_method(node: BrickscriptFlowNode, target: Array, member: Dictionary, where: String) -> PackedStringArray:
	var args: PackedStringArray = []
	var specs: Array[Dictionary] = Ops.input_specs(node).slice(1)
	var wanted: Array = member.get("args", [])
	if int(member.get("required", -1)) >= 0 and (specs.size() < member["required"] or specs.size() > wanted.size()):
		var count: String = str(wanted.size()) if member["required"] == wanted.size() else "%d to %d" % [member["required"], wanted.size()]
		errors.append("%s: %s takes %s value(s), not %d (+ / - to change)" % [where, member["name"], count, specs.size()])
		return []
	for i: int in specs.size():
		var given: Array = _input(node, specs[i], where)
		if given.is_empty():
			return []
		var arg_type: int = wanted[i] if i < wanted.size() else T.ANY
		if arg_type == T.RESOURCE and given[1] == T.TEXT:
			given = _loaded(given)
		if not Types.fits(given[1], arg_type):
			errors.append("%s > %s: needs a %s, got a %s" % [where, specs[i]["name"], Types.type_name(arg_type), Types.type_name(given[1])])
			return []
		var arg_class: StringName = (member.get("arg_nodes", []) as Array)[i].get("class", &"") if i < (member.get("arg_nodes", []) as Array).size() else &""
		if given[1] == T.RESOURCE and arg_type == T.RESOURCE and not _resource_fits(given[2], arg_class):
			errors.append("%s > %s: needs a %s, got %s" % [where, specs[i]["name"], arg_class, str(given[2].get("path", given[2].get("class", "a Resource"))).get_file()])
			return []
		var arg_node: Dictionary = (member.get("arg_nodes", []) as Array)[i] if i < (member.get("arg_nodes", []) as Array).size() else {}
		args.append(_as_path_if_path("roundi(%s)" % given[0] if arg_type == T.WHOLE and given[1] == T.NUMBER else given[0], arg_node))
	var name: String = node.output_name.strip_edges()
	if not name.is_empty() and member["type"] < 0:
		errors.append("%s > Output Var: %s returns nothing" % [where, member["name"]])
		return []
	var guard: String = _local_guard(node, target, where, member)
	if guard == LOCAL_REFUSED:
		return []
	var call: String = "%s.%s(%s)" % [target[0], member["name"], ", ".join(args)] if member["native"] or member.get("own", false) \
		else "%s.call(%s)" % [target[0], ", ".join([var_to_str(StringName(member["name"]))] + Array(args))]
	if not name.is_empty():
		call = _as_text_if_path(call, member.get("node", {}))
	if name.is_empty():
		return _guarded(guard, call)
	if not guard.is_empty():
		# Not allowed when the game runs: the Output Var gets nothing.
		call = "(%s if %s else %s)" % [call, guard.trim_prefix("if ").trim_suffix(": "), _default_code(member["type"]) if member["type"] != T.ANY else "null"]
	return _output(node, call, member["type"], where, member.get("node", {}))


## The Type / Script settings of Get node, Spawn scene and Export: a node
## type, or {} for "some Node". Script alone: its base class.
func _node_type_setting(node: BrickscriptFlowNode, where: String) -> Dictionary:
	var class_text: String = str(node.settings.get(&"node_class", "")).strip_edges()
	# Only bricks with a Script setting use one (an older Find node may still
	# have one stored).
	var has_script: bool = Library.get_definition(node.type).get("settings", []).any(func(setting: Dictionary) -> bool: return setting["name"] == &"node_script")
	var script: String = str(node.settings.get(&"node_script", "")).strip_edges() if has_script else ""
	if class_text.is_empty() and script.is_empty():
		return {}
	var named: Dictionary = NodeTypes.script_class(StringName(class_text)) if script.is_empty() else {}
	if not named.is_empty():
		# A script class by its name (ObjectWhole): its node class and script.
		return named
	if not class_text.is_empty() and not NodeTypes.is_node_class(StringName(class_text)):
		errors.append("%s > Type: '%s' is not a Node class" % [where, class_text])
		return {}
	if class_text.is_empty():
		class_text = String(_script_base(script))
	return {"class": StringName(class_text), "script": script} if not script.is_empty() else {"class": StringName(class_text)}


## A script's base class, without loading brickscripts (that would compile
## them).
func _script_base(path: String) -> StringName:
	if BrickFile.is_script_path(path):
		var graph: BrickscriptFlowGraph = BrickFile.load_graph(path)
		return graph.base_type if graph != null else &"Node"
	var node_type: Dictionary = NodeTypes.of_script(path)
	return node_type.get("class", &"Node")


func _describe(node_type: Dictionary) -> String:
	return "Self (%s)" % _base_type if node_type.get("self", false) else NodeTypes.describe(node_type)


## A member of a node type by name and kind, or {}.
func _find_member(node_type: Dictionary, name: String, kind: String) -> Dictionary:
	for member: Dictionary in _members(node_type):
		if member["name"] == name and member["kind"] == kind:
			return member
	return {}


## What a node of `node_type` has: for this node, this brickscript's own
## variables; for a script, its variables (another brickscript's only when
## `foreign`); then its class's properties and methods.
func _members(node_type: Dictionary) -> Array[Dictionary]:
	var result: Array[Dictionary] = []
	if node_type.get("self", false):
		result.append_array(declared_members())
		for member: Dictionary in result:
			member["own"] = true
	else:
		var script: String = str(node_type.get("script", ""))
		if not script.is_empty() and (foreign or not BrickFile.is_script_path(script)):
			result.append_array(script_members(script))
	result.append_array(NodeTypes.class_members(node_type.get("class", &"Node")))
	return result


## This brickscript's Constants, Exports and Shared variables as members
## (after compile()).
func declared_members() -> Array[Dictionary]:
	var result: Array[Dictionary] = []
	for name: String in _script:
		var variable: Dictionary = _script[name]
		result.append({"name": name, "kind": "property", "type": variable["type"], "node": variable.get("node", {}), "native": false,
			"writable": variable["writable"], "origin": _origin(name)})
	for name: String in _implicit:
		if not _script.has(name):
			result.append({"name": name, "kind": "property", "type": _implicit[name], "node": _implicit_nodes.get(name, {}), "native": false, "writable": true, "origin": _origin(name)})
	for name: String in _signals:
		var names: PackedStringArray = []
		for i: int in _signals[name]["types"].size():
			names.append("value_%d" % (i + 1))
		result.append({"name": name, "kind": "signal", "type": -1, "node": {}, "native": false, "writable": false, "origin": "Signal",
			"args": _signals[name]["types"], "arg_names": names, "arg_nodes": _signals[name]["nodes"], "required": names.size()})
	return result


## The variables (and methods) a script adds: a brickscript's declared ones,
## or a .gd script's.
static func script_members(path: String) -> Array[Dictionary]:
	if BrickFile.is_script_path(path):
		return BrickFile.declared_members(path)
	return NodeTypes.gd_script_members(path)


## Everything a node of `node_type` has (not "this node"; the editor's
## dropdowns use this).
static func members_of_type(node_type: Dictionary) -> Array[Dictionary]:
	var result: Array[Dictionary] = []
	var script: String = str(node_type.get("script", ""))
	if not script.is_empty():
		result.append_array(script_members(script))
	result.append_array(NodeTypes.class_members(node_type.get("class", &"Node")))
	return result


## A node path a member gives (a NodePath) as the Text Brickscript holds.
static func _as_text_if_path(code: String, node_type: Dictionary) -> String:
	return "str(%s)" % code if node_type.get("path", false) else code


## Text going where a member takes a node path (a NodePath).
static func _as_path_if_path(code: String, node_type: Dictionary) -> String:
	return "NodePath(%s)" % code if node_type.get("path", false) else code


func _member_target(target: String, member: Dictionary) -> String:
	return member["name"] if member.get("own", false) and target == "self" else "%s.%s" % [target, member["name"]]


func _member_read(target: String, member: Dictionary) -> String:
	if member["native"] or member.get("own", false):
		return _member_target(target, member)
	return "%s.get(%s)" % [target, var_to_str(StringName(member["name"]))]


func _member_write(target: String, member: Dictionary, value: String) -> String:
	if member["native"] or member.get("own", false):
		return "%s = %s" % [_member_target(target, member), value]
	return "%s.set(%s, %s)" % [target, var_to_str(StringName(member["name"])), value]


func _can_set(member: Dictionary, target: Array, where: String) -> bool:
	if not member["writable"]:
		var why: String = "a Constant" if member["origin"] == "Constant" else "an Export (make a changeable Shared copy)" if member.get("own", false) and member["origin"] == "Export" else "read-only"
		errors.append("%s: '%s' of %s is %s" % [where, member["name"], _describe(target[2]), why])
		return false
	return true


func _value_fits(value: Array, member: Dictionary, where: String) -> bool:
	if not Types.fits(value[1], member["type"]):
		errors.append("%s: '%s' is a %s, got a %s" % [where, member["name"], Types.type_name(member["type"]), Types.type_name(value[1])])
		return false
	if value[1] == T.NODE and member["type"] == T.NODE and not NodeTypes.fits(value[2], member.get("node", {})):
		errors.append("%s: '%s' holds a %s, got a %s" % [where, member["name"], NodeTypes.describe(member.get("node", {})), NodeTypes.describe(value[2])])
		return false
	if value[1] == T.RESOURCE and member["type"] == T.RESOURCE and not _resource_fits(value[2], member.get("node", {}).get("class", &"")):
		errors.append("%s: '%s' takes a %s, got %s" % [where, member["name"], member["node"]["class"], str(value[2].get("path", value[2].get("class", "a Resource"))).get_file()])
		return false
	if member["type"] == T.LIST and value[1] == T.LIST and NodeTypes.list_fit(value[2], member.get("node", {})) == "no":
		errors.append("%s: '%s' is a %s, got a %s" % [where, member["name"], NodeTypes.describe_list(member.get("node", {})), NodeTypes.describe_list(value[2])])
		return false
	return true


## A Text path as a Resource: `load(<path>)` when the brick runs (no class
## known, so it's checked then: a wrong or missing file gives null).
func _loaded(value: Array) -> Array:
	return ["load(%s)" % value[0], T.RESOURCE, {}]


## Whether a Resource value (a picked file, or a variable's class) can go
## where a `wanted` class is expected. Unknown classes are let through.
func _resource_fits(value_type: Dictionary, wanted: StringName) -> bool:
	if value_type.has("path"):
		return NodeTypes.resource_fits(value_type["path"], wanted)
	return NodeTypes.resource_class_fits(value_type.get("class", &"Resource"), wanted)


## The value as `member` takes it: decimals rounded into a Whole, a List
## converted into a typed List's items (set() would silently refuse it).
func _rounded(value: Array, member: Dictionary) -> String:
	if member["type"] == T.LIST and value[1] in [T.LIST, T.ANY]:
		var wanted: Dictionary = member.get("node", {})
		return NodeTypes.list_converted(value[0], wanted, NodeTypes.list_fit(value[2] if value[1] == T.LIST else {}, wanted))
	return "roundi(%s)" % value[0] if member["type"] == T.WHOLE and value[1] == T.NUMBER else value[0]

#endregion


## Tells the BrickscriptDebug autoload (runtime/brick_debug.gd) a brick ran.
const TRACE_HELPER: String = """func _brickscript_trace(brick: int) -> void:
	var debug: Node = get_node_or_null(^"/root/BrickscriptDebug")
	if debug != null:
		debug.call(&"trace", get_script().resource_path, brick)"""


func _trace_line(node_id: int) -> String:
	return "_brickscript_trace(%d)%s" % [node_id, marker(node_id)]


## The comment ending every line a brick makes (`  # brick <id>`): runtime
## errors are traced back to their brick by it (runtime/brick_debug.gd).
static func marker(node_id: int) -> String:
	return "  # brick %d" % node_id


## Single pass, so typed-in text that looks like "{b}" is never filled again.
func _fill(template: String, codes: Dictionary[String, String]) -> String:
	var result: String = ""
	var last_end: int = 0
	for found: RegExMatch in _placeholder.search_all(template):
		result += template.substr(last_end, found.get_start() - last_end) + codes.get(found.get_string(1), found.get_string())
		last_end = found.get_end()
	return result + template.substr(last_end)


func _where(node: BrickscriptFlowNode, definition: Dictionary) -> String:
	return "%s (node %d)" % [definition.get("title", String(node.type)), node.id]
